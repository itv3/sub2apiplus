{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-predecessor-import-v9.json",
  "title": "Codex Candidate 运行时场景纠正导入收据",
  "description": "只读承接前序 official、分类和证据绑定，仅允许为固定五个 Candidate Job 新增 CODEX_BIN，并强制绑定当前完整 Job 演练。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at_utc",
    "reason",
    "successor_campaign_id",
    "successor_campaign_manifest_sha256",
    "predecessor_campaign",
    "stages",
    "copied_files",
    "configuration_transition",
    "job_rehearsal_transition",
    "target_scenario_transition",
    "abandoned_candidate_attempt",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-upgrade-predecessor-import/v9"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "const": "candidate_runtime_identity_correction"
    },
    "successor_campaign_id": {
      "$ref": "#/$defs/safeId"
    },
    "successor_campaign_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "predecessor_campaign": {
      "$ref": "#/$defs/predecessorCampaign"
    },
    "stages": {
      "$ref": "#/$defs/stages"
    },
    "copied_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/copiedFile"
      }
    },
    "configuration_transition": {
      "$ref": "#/$defs/configurationTransition"
    },
    "job_rehearsal_transition": {
      "$ref": "#/$defs/jobRehearsalTransition"
    },
    "target_scenario_transition": {
      "$ref": "#/$defs/targetScenarioTransition"
    },
    "official_reuse_target_scenario_transition": {
      "$ref": "#/$defs/officialReuseTargetScenarioTransition"
    },
    "recovery_control_transition": {
      "$ref": "#/$defs/recoveryControlTransition"
    },
    "abandoned_candidate_attempt": {
      "oneOf": [
        {
          "$ref": "#/$defs/abandonedAttempt"
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/"
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fileBindingWithBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "predecessorCampaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_dir",
        "campaign_id",
        "campaign_manifest_sha256"
      ],
      "properties": {
        "campaign_dir": {
          "$ref": "#/$defs/absolutePath"
        },
        "campaign_id": {
          "$ref": "#/$defs/safeId"
        },
        "campaign_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "officialStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "package_digest",
        "evidence_inventory_digest",
        "security_sha256"
      ],
      "properties": {
        "path": {
          "const": "official/result.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "package_digest": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_inventory_digest": {
          "$ref": "#/$defs/sha256"
        },
        "security_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "classificationStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "package_digest",
        "joint_manifest_sha256"
      ],
      "properties": {
        "path": {
          "const": "classification/result.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "package_digest": {
          "$ref": "#/$defs/sha256"
        },
        "joint_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture-official",
        "classify"
      ],
      "properties": {
        "capture-official": {
          "$ref": "#/$defs/officialStage"
        },
        "classify": {
          "$ref": "#/$defs/classificationStage"
        }
      }
    },
    "copiedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_path",
        "target_path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "plan_inputs",
            "plan_analysis",
            "approved_classification",
            "runtime_target_scenario",
            "official_reuse_target_scenario",
            "official_surface"
          ]
        },
        "source_path": {
          "$ref": "#/$defs/relativePath"
        },
        "target_path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "accountTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessor",
        "successor",
        "reason"
      ],
      "properties": {
        "predecessor": {
          "type": "integer",
          "minimum": 1
        },
        "successor": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "const": "operator_selected_active_account"
        }
      }
    },
    "configurationTransition": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "live_attestation_compose_dir": [
          "live_attestation_compose_files"
        ],
        "live_attestation_compose_files": [
          "live_attestation_compose_dir"
        ]
      },
      "required": [
        "codex_account_id"
      ],
      "properties": {
        "codex_account_id": {
          "$ref": "#/$defs/accountTransition"
        },
        "live_attestation_compose_dir": {
          "$ref": "#/$defs/runtimeConfigurationTransition"
        },
        "live_attestation_compose_files": {
          "$ref": "#/$defs/runtimeConfigurationTransition"
        }
      }
    },
    "runtimeConfigurationTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessor",
        "successor",
        "reason"
      ],
      "properties": {
        "predecessor": {
          "type": "string"
        },
        "successor": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "const": "candidate_runtime_identity_correction"
        }
      }
    },
    "upgradeTimingControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_dir",
        "ledger_plan_sha256",
        "receipt",
        "upgrade_id",
        "evidence_decision",
        "checkpoint_head_sha256"
      ],
      "properties": {
        "ledger_dir": {
          "$ref": "#/$defs/absolutePath"
        },
        "ledger_plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt": {
          "$ref": "#/$defs/fileBindingWithBytes"
        },
        "upgrade_id": {
          "$ref": "#/$defs/safeId"
        },
        "evidence_decision": {
          "enum": [
            "reuse",
            "recapture"
          ]
        },
        "checkpoint_head_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "arm64EnvironmentControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_root",
        "receipt",
        "subject_id",
        "contract_sha256",
        "continuity_identity_sha256"
      ],
      "properties": {
        "evidence_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "receipt": {
          "$ref": "#/$defs/fileBindingWithBytes"
        },
        "subject_id": {
          "$ref": "#/$defs/safeId"
        },
        "contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "continuity_identity_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "jobRehearsalControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_root",
        "receipt",
        "preflight_campaign_id",
        "preflight_campaign_manifest_sha256",
        "execution_contract_sha256",
        "runtime_identity_sha256",
        "job_count",
        "job_set_sha256"
      ],
      "properties": {
        "evidence_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "receipt": {
          "$ref": "#/$defs/fileBindingWithBytes"
        },
        "preflight_campaign_id": {
          "$ref": "#/$defs/safeId"
        },
        "preflight_campaign_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "execution_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "job_count": {
          "type": "integer",
          "minimum": 1
        },
        "job_set_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "controlReceipts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upgrade_timing",
        "arm64_environment",
        "job_rehearsal"
      ],
      "properties": {
        "upgrade_timing": {
          "$ref": "#/$defs/upgradeTimingControl"
        },
        "arm64_environment": {
          "$ref": "#/$defs/arm64EnvironmentControl"
        },
        "job_rehearsal": {
          "$ref": "#/$defs/jobRehearsalControl"
        }
      }
    },
    "jobRehearsalTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "predecessor",
        "successor"
      ],
      "properties": {
        "reason": {
          "const": "current_execution_contract_rehearsal"
        },
        "predecessor": {
          "$ref": "#/$defs/jobRehearsalControl"
        },
        "successor": {
          "$ref": "#/$defs/jobRehearsalControl"
        }
      }
    },
    "targetScenarioTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "predecessor",
        "successor",
        "changed_job_ids"
      ],
      "properties": {
        "reason": {
          "const": "candidate_codex_binary_binding_correction"
        },
        "predecessor": {
          "$ref": "#/$defs/fileBinding"
        },
        "successor": {
          "$ref": "#/$defs/fileBinding"
        },
        "changed_job_ids": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "enum": [
              "candidate-compact-direct",
              "candidate-compact-mitm",
              "candidate-core-direct",
              "candidate-core-mitm",
              "candidate-ws-handshake-repeat"
            ]
          }
        }
      }
    },
    "sourceStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "package_digest"
      ],
      "properties": {
        "path": {
          "const": "official/result.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "package_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "stageControlTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "source_stage",
        "evaluation_transition",
        "predecessor",
        "successor"
      ],
      "properties": {
        "reason": {
          "const": "sealed_stage_control_recovery"
        },
        "source_stage": {
          "$ref": "#/$defs/sourceStage"
        },
        "evaluation_transition": {
          "$ref": "#/$defs/fileBinding"
        },
        "predecessor": {
          "$ref": "#/$defs/controlReceipts"
        },
        "successor": {
          "$ref": "#/$defs/controlReceipts"
        }
      }
    },
    "recoveryControlPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upgrade_timing",
        "arm64_environment"
      ],
      "properties": {
        "upgrade_timing": {
          "$ref": "#/$defs/upgradeTimingControl"
        },
        "arm64_environment": {
          "$ref": "#/$defs/arm64EnvironmentControl"
        }
      }
    },
    "stopCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_dir",
        "receipt",
        "upgrade_id",
        "active_phase",
        "head_sequence",
        "head_sha256",
        "total_elapsed_seconds",
        "total_live_request_count"
      ],
      "properties": {
        "ledger_dir": {
          "$ref": "#/$defs/absolutePath"
        },
        "receipt": {
          "$ref": "#/$defs/fileBindingWithBytes"
        },
        "upgrade_id": {
          "$ref": "#/$defs/safeId"
        },
        "active_phase": {
          "enum": [
            "VC-0",
            "VC-1",
            "VC-2",
            "VC-3",
            "VC-4",
            "VC-5",
            "VC-6"
          ]
        },
        "head_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "head_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "total_elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "total_live_request_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "recoveryControlTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "predecessor",
        "stop_checkpoint",
        "successor"
      ],
      "properties": {
        "reason": {
          "const": "stopped_ledger_recovery"
        },
        "predecessor": {
          "$ref": "#/$defs/recoveryControlPair"
        },
        "stop_checkpoint": {
          "$ref": "#/$defs/stopCheckpoint"
        },
        "source_transition": {
          "$ref": "#/$defs/fileBinding"
        },
        "successor": {
          "$ref": "#/$defs/recoveryControlPair"
        }
      }
    },
    "executionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed_job_ids",
        "scanned_bytes",
        "live_request_count"
      ],
      "properties": {
        "executed_job_ids": {
          "const": []
        },
        "scanned_bytes": {
          "const": 0
        },
        "live_request_count": {
          "const": 0
        }
      }
    },
    "abandonedAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "attempt_id",
        "path",
        "sha256",
        "attempt_digest",
        "identity_sha256",
        "status"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/safeId"
        },
        "attempt_id": {
          "$ref": "#/$defs/safeId"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "attempt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "awaiting_receipts",
            "failed",
            "environment_contaminated"
          ]
        }
      }
    },
    "officialReuseTargetScenarioTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "predecessor",
        "successor",
        "preflight_campaign",
        "added_job_ids",
        "removed_job_ids",
        "changed_job_ids"
      ],
      "properties": {
        "reason": {
          "const": "official_evidence_reuse_candidate_job_update"
        },
        "predecessor": {
          "$ref": "#/$defs/fileBinding"
        },
        "successor": {
          "$ref": "#/$defs/fileBinding"
        },
        "preflight_campaign": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "campaign_id",
            "manifest_sha256"
          ],
          "properties": {
            "campaign_id": {
              "$ref": "#/$defs/safeId"
            },
            "manifest_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "added_job_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeId"
          }
        },
        "removed_job_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeId"
          }
        },
        "changed_job_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeId"
          }
        }
      }
    }
  }
}
