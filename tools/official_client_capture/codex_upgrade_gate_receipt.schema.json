{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-external-gate-receipt-v4.json",
  "title": "Codex 升级外部门禁 attempt 链收据",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "status",
    "attempt",
    "subject",
    "inputs",
    "gate_plan",
    "environment",
    "executed_gate_ids",
    "carried_gate_ids",
    "passed_gate_ids",
    "failed_gate_ids",
    "effective_gates",
    "completed_at_utc",
    "producer"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-upgrade-external-gate-receipt/v4"
    },
    "phase": {
      "enum": [
        "candidate_external",
        "post_promotion"
      ]
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "attempt": {
      "$ref": "#/$defs/attempt"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inputBinding"
      }
    },
    "gate_plan": {
      "oneOf": [
        {
          "$ref": "#/$defs/gatePlanBinding"
        },
        {
          "type": "null"
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after",
        "continuity_identity_sha256"
      ],
      "properties": {
        "before": {
          "$ref": "#/$defs/binding"
        },
        "after": {
          "$ref": "#/$defs/binding"
        },
        "continuity_identity_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "executed_gate_ids": {
      "$ref": "#/$defs/gateIds"
    },
    "carried_gate_ids": {
      "$ref": "#/$defs/gateIds"
    },
    "passed_gate_ids": {
      "$ref": "#/$defs/gateIds"
    },
    "failed_gate_ids": {
      "$ref": "#/$defs/gateIds"
    },
    "effective_gates": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/effectiveGate"
      }
    },
    "completed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "candidatePurpose": {
      "enum": [
        "validation_only",
        "production_replacement"
      ]
    },
    "gateIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/safeId"
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "nullableBinding": {
      "oneOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "role": {
          "enum": [
            "acceptance",
            "promotion"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "gatePlanBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes",
        "plan_sha256",
        "requirements_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "requirements_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "root_cause_id",
        "same_root_cause_failure_count",
        "previous_receipt"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/safeId"
        },
        "root_cause_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/safeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "same_root_cause_failure_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "previous_receipt": {
          "$ref": "#/$defs/nullableBinding"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "campaign_mode",
        "campaign_purpose",
        "candidate_id",
        "candidate_purpose",
        "target_version",
        "target_architecture",
        "profile_id",
        "profile_digest",
        "candidate_package_digest",
        "candidate_source_tree_sha256",
        "candidate_image_id",
        "candidate_image_reference",
        "production_tree_sha256",
        "acceptance_sha256",
        "promotion_receipt_sha256"
      ],
      "properties": {
        "campaign_id": {
          "$ref": "#/$defs/safeId"
        },
        "campaign_mode": {
          "const": "formal"
        },
        "campaign_purpose": {
          "$ref": "#/$defs/candidatePurpose"
        },
        "candidate_id": {
          "$ref": "#/$defs/safeId"
        },
        "candidate_purpose": {
          "$ref": "#/$defs/candidatePurpose"
        },
        "target_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "target_architecture": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        },
        "profile_id": {
          "$ref": "#/$defs/safeId"
        },
        "profile_digest": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_package_digest": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_source_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_image_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "candidate_image_reference": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:+-]*@sha256:[0-9a-f]{64}$"
        },
        "production_tree_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "acceptance_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "promotion_receipt_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "effectiveGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "command",
        "working_directory",
        "host",
        "architecture",
        "started_at_utc",
        "completed_at_utc",
        "exit_code",
        "status",
        "passed_count",
        "failed_count",
        "skipped_count",
        "stdout_sha256",
        "stderr_sha256",
        "evidence",
        "disposition",
        "carried_from_attempt"
      ],
      "properties": {
        "gate_id": {
          "$ref": "#/$defs/safeId"
        },
        "test_id": {
          "$ref": "#/$defs/safeId"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "working_directory": {
          "enum": [
            ".",
            "backend"
          ]
        },
        "host": {
          "$ref": "#/$defs/safeId"
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "started_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "exit_code": {
          "type": "integer"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "passed_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_count": {
          "const": 0
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "disposition": {
          "enum": [
            "executed",
            "carried"
          ]
        },
        "carried_from_attempt": {
          "oneOf": [
            {
              "$ref": "#/$defs/safeId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tool",
        "tool_sha256",
        "facts"
      ],
      "properties": {
        "schema_version": {
          "const": "codex-upgrade-external-gate-producer/v4"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "tool_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "facts": {
          "$ref": "#/$defs/binding"
        }
      }
    }
  }
}
