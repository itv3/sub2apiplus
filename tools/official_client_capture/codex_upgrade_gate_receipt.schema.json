{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-external-gate-receipt-v2.json",
  "title": "Codex 升级外部门禁收据",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "subject",
    "inputs",
    "gates",
    "completed_at_utc",
    "producer"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-upgrade-external-gate-receipt/v2"
    },
    "phase": {
      "enum": [
        "candidate_external",
        "post_promotion"
      ]
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inputBinding"
      }
    },
    "gates": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "completed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "candidate_external"
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "maxItems": 0
          },
          "subject": {
            "properties": {
              "production_tree_sha256": {
                "type": "null"
              },
              "acceptance_sha256": {
                "type": "null"
              },
              "promotion_receipt_sha256": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "inputs": {
            "minItems": 2,
            "maxItems": 2
          },
          "subject": {
            "properties": {
              "production_tree_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "acceptance_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "promotion_receipt_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "campaign_mode": {
                "const": "formal"
              },
              "campaign_purpose": {
                "const": "production_replacement"
              },
              "candidate_purpose": {
                "const": "production_replacement"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidatePurpose": {
      "enum": [
        "validation_only",
        "production_replacement"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "role": {
          "enum": [
            "acceptance",
            "promotion"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "campaign_mode",
        "campaign_purpose",
        "candidate_id",
        "candidate_purpose",
        "target_version",
        "target_architecture",
        "profile_id",
        "profile_digest",
        "candidate_package_digest",
        "candidate_source_tree_sha256",
        "candidate_image_id",
        "candidate_image_reference",
        "production_tree_sha256",
        "acceptance_sha256",
        "promotion_receipt_sha256"
      ],
      "properties": {
        "campaign_id": {
          "type": "string",
          "minLength": 1
        },
        "campaign_mode": {
          "const": "formal"
        },
        "campaign_purpose": {
          "$ref": "#/$defs/candidatePurpose"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_purpose": {
          "$ref": "#/$defs/candidatePurpose"
        },
        "target_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "target_architecture": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_digest": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_package_digest": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_source_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_image_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "candidate_image_reference": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:+-]*@sha256:[0-9a-f]{64}$"
        },
        "production_tree_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptance_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "promotion_receipt_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "command",
        "working_directory",
        "host",
        "architecture",
        "started_at_utc",
        "completed_at_utc",
        "exit_code",
        "status",
        "passed_count",
        "failed_count",
        "skipped_count",
        "stdout_sha256",
        "stderr_sha256",
        "evidence"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "working_directory": {
          "enum": [
            ".",
            "backend"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "started_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "exit_code": {
          "const": 0
        },
        "status": {
          "const": "passed"
        },
        "passed_count": {
          "type": "integer",
          "minimum": 1
        },
        "failed_count": {
          "const": 0
        },
        "skipped_count": {
          "const": 0
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/binding"
          }
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tool",
        "tool_sha256",
        "facts"
      ],
      "properties": {
        "schema_version": {
          "const": "codex-upgrade-external-gate-producer/v2"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "tool_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "facts": {
          "$ref": "#/$defs/binding"
        }
      }
    }
  }
}
