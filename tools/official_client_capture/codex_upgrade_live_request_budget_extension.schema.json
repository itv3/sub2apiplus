{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/live-request-budget-extension-v1.json",
  "title": "请求预算延长批准收据：原有效预算承接、总账 head 与批准人不可改写（修好接着跑第 14 项）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "original_budget",
    "new_budget",
    "consumed_at_preview",
    "reason",
    "project_ledger_path",
    "project_ledger_head",
    "review_sha256",
    "approved_by",
    "approved_at_utc",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "live-request-budget-extension/v1"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "original_budget": {
      "type": "integer",
      "minimum": 1
    },
    "new_budget": {
      "type": "integer",
      "minimum": 2
    },
    "consumed_at_preview": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "project_ledger_path": {
      "type": "string",
      "minLength": 1
    },
    "project_ledger_head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "sha256"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "review_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
