{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/candidate-rule-assertion-result-v1.json",
  "title": "候选侧单规则已执行断言结果",
  "description": "证明断言程序已经执行，并把逐项语义判断绑定到 checker、命令和候选原始证据。仅 exit_code=0 或仅任务成功不满足本结构。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_id",
    "status",
    "started_at",
    "finished_at",
    "exit_code",
    "checker_sha256",
    "command_sha256",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-candidate-rule-assertion/v1"
    },
    "rule_id": {
      "type": "string",
      "pattern": "^SPEC-[A-Z0-9]+-[0-9]{3}$"
    },
    "status": {
      "const": "pass"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "exit_code": {
      "const": 0
    },
    "checker_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "command_sha256": {
      "type": "string",
      "description": "对 UTF-8 编码的紧凑 JSON 命令参数数组计算 SHA-256。",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "passed",
          "expected",
          "actual",
          "evidence_paths"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "passed": {
            "const": true
          },
          "expected": {
            "not": {
              "type": "null"
            }
          },
          "actual": {
            "not": {
              "type": "null"
            }
          },
          "evidence_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
