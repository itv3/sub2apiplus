t to hpack decoder for long sequences of `0xFF` values to prevent malicious use.","fixed_in":["4.2.0"],"id":"PYSEC-2026-4053","link":"https://osv.dev/vulnerability/PYSEC-2026-4053","source":"osv","summary":null,"withdrawn":null}],"wheel":{"bytes":34357,"path":"wheels/hpack-4.1.0-py3-none-any.whl","sha256":"157ac792668d995c657d93111f46b4535ed114f0c9c8d672271bbec7eae1b496"},"wheel_url":"https://files.pythonhosted.org/packages/07/c6/80c95b1b2b94682a72cbdbfb85b81ae2daffa4291fbfa1b1464502ede10d/hpack-4.1.0-py3-none-any.whl"}],"schema_version":"claude-upgrade-h2-private-dependencies/v1","source_scope":"regression_fixture"}
