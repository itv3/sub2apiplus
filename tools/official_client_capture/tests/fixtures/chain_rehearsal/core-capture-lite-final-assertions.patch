+def _decoded_request_body(data):
+    """还原 relay 抓到的一条请求的正文：先解分块传输，再解 zstd（Lite 轨道的请求体是 zstd 压缩的）。"""
+    head, _, body = data.partition(b"\r\n\r\n")
+    lowered = head.lower()
+    if b"\r\ntransfer-encoding: chunked" in lowered:
+        decoded, rest = b"", body
+        while rest:
+            size_line, _, rest = rest.partition(b"\r\n")
+            size = int(size_line.split(b";", 1)[0], 16)
+            if size == 0:
+                break
+            decoded += rest[:size]
+            rest = rest[size + 2:]
+        body = decoded
+    if b"\r\ncontent-encoding: zstd" in lowered:
+        try:
+            import io
+            import zstandard
+            body = zstandard.ZstdDecompressor().stream_reader(io.BytesIO(body)).read()
+        except ImportError:
+            import subprocess
+            result = subprocess.run(["zstd", "-dc"], input=body, capture_output=True, check=False)
+            if result.returncode != 0:
+                raise SystemExit("relay 请求正文 zstd 解压失败（zstd 命令）")
+            body = result.stdout
+        except Exception as error:
+            raise SystemExit(f"relay 请求正文 zstd 解压失败：{error}") from error
+    return body
+
