+def _isolation_window_reusable(
+    campaign_dir: Path,
+    phase: str,
+    candidate_id: str | None,
+    attempt_id: str,
+    complete_job_ids: Sequence[str],
+) -> list[str]:
+    """环境隔离带污染窗口时，窗口起点之前完成且出口时段绑定可核验的已完成作业（与 resume 同一判定）。
+
+    resume 的失败重跑闭集（``codex_upgrade`` 的失败 attempt 范围计算）对被隔离的 attempt 这样处理：隔离收据带
+    ``contamination_started_at_utc`` 时，污染发生时刻之前完成、``runtime_egress`` 绑定可核验的作业保留复用
+    （``reused_before_contamination``），其余并入执行闭集。恢复预览必须给出同一集合：没有隔离、隔离无窗口或没有已完成
+    作业时返回空列表（原口径：被污染 attempt 的结果不复用）。判定函数直接取 resume 的那几个，不另写一份。
+    """
+
+    isolation = codex_upgrade._attempt_isolation_receipt(campaign_dir, phase, candidate_id, attempt_id)
+    if isolation is None or not complete_job_ids:
+        return []
+    window_start = codex_upgrade._contamination_window_start_epoch(isolation)
+    if window_start is None:
+        return []
+    adapter = _adapter()
+    attempt_root = campaign_dir / adapter.orchestrator._capture_attempt_relative(phase, candidate_id) / "attempts" / attempt_id
+    attempt_path = attempt_root / "attempt.json"
+    if not attempt_path.is_file() or attempt_path.is_symlink():
+        return []
+    attempt = _read_json(attempt_path, "恢复预览的源 attempt")
+    results: dict[str, Mapping[str, Any]] = {}
+    for item in attempt.get("results", []):
+        if isinstance(item, Mapping) and isinstance(item.get("id"), str):
+            results[item["id"]] = item
+    return sorted(
+        job_id
+        for job_id in complete_job_ids
+        if job_id in results and codex_upgrade._job_finished_before(results[job_id], window_start)
+    )
+
