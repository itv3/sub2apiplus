{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-stage-result-v2.json",
  "title": "Codex 出站升级不可变阶段收据",
  "description": "每个阶段和 candidate-id 只允许封存一次。所有收据统一使用 stage envelope，业务结果原 schema 放在 result_schema_version，并通过 package_digest 与不可变 campaign.json 绑定。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "campaign_id",
    "campaign_mode",
    "campaign_purpose",
    "candidate_purpose",
    "campaign_manifest_sha256",
    "sealed_at_utc",
    "package_digest",
    "status"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "codex-upgrade-stage-result/v2"
    },
    "result_schema_version": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/v[0-9]+$"
    },
    "stage": {
      "enum": [
        "capture-official",
        "classify",
        "capture-candidate",
        "compare",
        "accept"
      ]
    },
    "campaign_id": {
      "$ref": "#/$defs/safeId"
    },
    "campaign_mode": {
      "const": "formal"
    },
    "campaign_purpose": {
      "$ref": "#/$defs/candidatePurpose"
    },
    "candidate_purpose": {
      "oneOf": [
        {"$ref": "#/$defs/candidatePurpose"},
        {"type": "null"}
      ]
    },
    "candidate_id": {
      "$ref": "#/$defs/safeId"
    },
    "campaign_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "sealed_at_utc": {
      "$ref": "#/$defs/timestamp"
    },
    "package_digest": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "enum": [
        "complete",
        "blocked",
        "failed"
      ]
    },
    "identity": {
      "type": "object",
      "minProperties": 1
    },
    "attempt": {
      "$ref": "#/$defs/fileBinding"
    },
    "seal_preview": {
      "$ref": "#/$defs/fileBinding"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "evidence_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/absolutePath"
      }
    },
    "evidence_inventory": {
      "$ref": "#/$defs/evidenceInventory"
    },
    "surface": {
      "$ref": "#/$defs/fileBinding"
    },
    "client_bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/clientBinding"
      }
    },
    "assertion_context": {
      "$ref": "#/$defs/assertionContext"
    },
    "assertion_gate": {
      "type": "object",
      "minProperties": 1
    },
    "observed_profile": {
      "$ref": "#/$defs/fileBinding"
    },
    "restoration": {
      "$ref": "#/$defs/restoration"
    },
    "security": {
      "$ref": "#/$defs/security"
    },
    "binary_verification": {
      "$ref": "#/$defs/binaryVerification"
    },
    "target_rule_manifest": {
      "$ref": "#/$defs/fileBinding"
    },
    "migration_manifest": {
      "$ref": "#/$defs/fileBinding"
    },
    "scenario_manifest": {
      "$ref": "#/$defs/fileBinding"
    },
    "profile_manifest": {
      "$ref": "#/$defs/fileBinding"
    },
    "assertion_profile_manifest": {
      "$ref": "#/$defs/fileBinding"
    },
    "joint_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "baseline_rule_count": {
      "type": "integer",
      "minimum": 1
    },
    "target_rule_count": {
      "type": "integer",
      "minimum": 1
    },
    "migration": {
      "$ref": "#/$defs/migrationSummary"
    },
    "source_diff_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "official_diff_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "target_version": {
      "$ref": "#/$defs/version"
    },
    "equal": {
      "type": "boolean"
    },
    "official_to_candidate": {
      "type": "object"
    },
    "coverage": {
      "type": "object"
    },
    "official_package_digest": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_package_digest": {
      "$ref": "#/$defs/sha256"
    },
    "classification_package_digest": {
      "$ref": "#/$defs/sha256"
    },
    "comparison_package_digest": {
      "$ref": "#/$defs/sha256"
    },
    "official_evidence_inventory_digest": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_evidence_inventory_digest": {
      "$ref": "#/$defs/sha256"
    },
    "profile_id": {
      "$ref": "#/$defs/safeId"
    },
    "profile_digest": {
      "$ref": "#/$defs/sha256"
    },
    "profile_binding_matches": {
      "type": "boolean"
    },
    "offline_only": {
      "type": "boolean"
    },
    "accepted": {
      "type": "boolean"
    },
    "assertion_result": {
      "$ref": "#/$defs/fileBinding"
    },
    "assertions": {
      "type": "object"
    },
    "gates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "failed_gates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "evidence_seal": {
      "$ref": "#/$defs/fileBinding"
    },
    "candidate_identity": {
      "$ref": "#/$defs/candidateIdentityProjection"
    },
    "candidate_external_gate": {
      "$ref": "#/$defs/externalGateBinding"
    },
    "production_state": {
      "const": "accepted_not_activated"
    },
    "predecessor_import": {
      "$ref": "#/$defs/fileBinding"
    },
    "predecessor_package_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "stage": {
                "const": "capture-official"
              }
            },
            "required": [
              "stage"
            ]
          },
          {
            "not": {
              "required": [
                "predecessor_import"
              ]
            }
          }
        ]
      },
      "then": {
        "required": [
          "binary_verification"
        ],
        "properties": {
          "client_bindings": {
            "type": "array",
            "maxItems": 0
          },
          "restoration": {
            "type": "object",
            "not": {
              "required": [
                "post_client"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "stage": {
                "enum": [
                  "capture-official",
                  "capture-candidate"
                ]
              }
            },
            "required": [
              "stage"
            ]
          },
          {
            "not": {
              "required": [
                "predecessor_import"
              ]
            }
          }
        ]
      },
      "then": {
        "required": [
          "identity",
          "attempt",
          "seal_preview",
          "results",
          "evidence_roots",
          "evidence_inventory",
          "surface",
          "client_bindings",
          "assertion_context",
          "assertion_gate",
          "restoration",
          "security"
        ]
      }
    },
    {
      "if": {
        "required": [
          "predecessor_import"
        ]
      },
      "then": {
        "required": [
          "predecessor_package_digest"
        ],
        "properties": {
          "stage": {
            "enum": [
              "capture-official",
              "classify"
            ]
          },
          "status": {
            "const": "complete"
          },
          "candidate_purpose": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "required": [
              "predecessor_import"
            ]
          },
          {
            "properties": {
              "stage": {
                "const": "capture-official"
              }
            },
            "required": [
              "stage"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "surface"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "capture-candidate"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "required": [
          "candidate_id",
          "candidate_purpose",
          "observed_profile"
        ],
        "properties": {
          "client_bindings": {
            "type": "array",
            "minItems": 2,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "client_id": {
                      "const": "kilo-compatible"
                    }
                  },
                  "required": [
                    "client_id"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "client_id": {
                      "const": "kilo-responses"
                    }
                  },
                  "required": [
                    "client_id"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          },
          "restoration": {
            "type": "object",
            "required": [
              "post_client"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "classify"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "required": [
          "target_rule_manifest",
          "migration_manifest",
          "scenario_manifest",
          "profile_manifest",
          "assertion_profile_manifest",
          "joint_manifest_sha256",
          "baseline_rule_count",
          "target_rule_count",
          "migration",
          "source_diff_sha256",
          "official_diff_sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "compare"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "required": [
          "candidate_id",
          "candidate_purpose",
          "result_schema_version",
          "target_version",
          "equal",
          "official_to_candidate",
          "coverage",
          "official_package_digest",
          "candidate_package_digest",
          "classification_package_digest",
          "official_evidence_inventory_digest",
          "candidate_evidence_inventory_digest",
          "profile_id",
          "profile_digest",
          "profile_binding_matches",
          "offline_only"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "accept"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "required": [
          "candidate_id",
          "candidate_purpose",
          "result_schema_version",
          "accepted",
          "target_version",
          "profile_id",
          "profile_digest",
          "assertion_result",
          "assertions",
          "gates",
          "failed_gates",
          "official_package_digest",
          "candidate_package_digest",
          "comparison_package_digest",
          "classification_package_digest",
          "official_evidence_inventory_digest",
          "candidate_evidence_inventory_digest",
          "evidence_seal",
          "candidate_identity",
          "candidate_external_gate",
          "production_state"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "capture-candidate",
              "compare",
              "accept"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "required": [
          "candidate_id",
          "candidate_purpose"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "capture-official",
              "classify"
            ]
          }
        },
        "required": ["stage"]
      },
      "then": {
        "properties": {
          "candidate_purpose": {"const": null}
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "candidatePurpose": {
      "enum": [
        "validation_only",
        "production_replacement"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "imageId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "immutableImage": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:+-]*@sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fileBindingWithBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "candidateIdentityProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_tree_sha256",
        "image_id",
        "image_reference",
        "build_id",
        "deployed_version",
        "candidate_purpose"
      ],
      "properties": {
        "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "image_id": {"$ref": "#/$defs/imageId"},
        "image_reference": {"$ref": "#/$defs/immutableImage"},
        "build_id": {"$ref": "#/$defs/safeId"},
        "deployed_version": {"$ref": "#/$defs/safeId"},
        "candidate_purpose": {"$ref": "#/$defs/candidatePurpose"}
      }
    },
    "externalGateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_root", "receipt"],
      "properties": {
        "evidence_root": {"$ref": "#/$defs/absolutePath"},
        "receipt": {"$ref": "#/$defs/fileBindingWithBytes"}
      }
    },
    "fileBindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fileBinding"
      }
    },
    "fileBindingsWithBytes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fileBindingWithBytes"
      }
    },
    "evidenceInventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidenceInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_count",
        "entries",
        "digest"
      ],
      "properties": {
        "entry_count": {
          "type": "integer",
          "minimum": 1
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceInventoryEntry"
          }
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "secretFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rule",
        "offset"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "rule": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_evidence_private",
        "known_secret_scan_passed",
        "known_secret_env_names",
        "file_count",
        "scanned_bytes",
        "findings",
        "limitation"
      ],
      "properties": {
        "raw_evidence_private": {
          "const": true
        },
        "known_secret_scan_passed": {
          "const": true
        },
        "known_secret_env_names": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "file_count": {
          "type": "integer",
          "minimum": 1
        },
        "scanned_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "findings": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "$ref": "#/$defs/secretFinding"
          }
        },
        "limitation": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmptyText"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "restorationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "comparator",
        "passed",
        "expected",
        "actual",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "enum": [
            "service_state_restored",
            "container_state_restored",
            "database_state_preserved",
            "account_state_preserved",
            "configuration_state_restored"
          ]
        },
        "comparator": {
          "enum": [
            "byte_equal",
            "before_subset"
          ]
        },
        "passed": {
          "const": true
        },
        "expected": {
          "type": "object",
          "minProperties": 2
        },
        "actual": {
          "type": "object",
          "minProperties": 2
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/restorationEvidenceRef"
                },
                {
                  "type": "object",
                  "properties": {
                    "role": {
                      "const": "before"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/restorationEvidenceRef"
                },
                {
                  "type": "object",
                  "properties": {
                    "role": {
                      "const": "after"
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        }
      }
    },
    "restorationEvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "role": {
          "enum": [
            "before",
            "after"
          ]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "restoration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "report",
        "checks"
      ],
      "properties": {
        "passed": {
          "const": true
        },
        "report": {
          "$ref": "#/$defs/fileBinding"
        },
        "checks": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/restorationCheck"
          }
        },
        "post_client": {
          "$ref": "#/$defs/restorationGate"
        }
      }
    },
    "restorationGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "report",
        "checks"
      ],
      "properties": {
        "passed": {
          "const": true
        },
        "report": {
          "$ref": "#/$defs/fileBinding"
        },
        "checks": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/restorationCheck"
          }
        }
      }
    },
    "assertionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_manifest",
        "capture_manifest_path",
        "evidence_root",
        "evidence_prefix"
      ],
      "properties": {
        "capture_manifest": {
          "$ref": "#/$defs/fileBinding"
        },
        "capture_manifest_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "evidence_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "evidence_prefix": {
          "$ref": "#/$defs/nonEmptyText"
        }
      }
    },
    "clientBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "attempt_id",
        "run_nonce",
        "attempt_started_at_utc",
        "client_checkpoint_at_utc",
        "client_id",
        "status",
        "client_version",
        "protocol",
        "entrypoint",
        "model",
        "profile_id",
        "profile_digest",
        "receipt",
        "source_tree_sha256",
        "build_id",
        "deployed_version",
        "request_evidence",
        "response_evidence",
        "request_proof",
