{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-manifest-projection-v1.json",
  "title": "EvidenceManifest 按根投影来源收据（保留根与丢弃根的精确集合、来源与投影清单摘要）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "candidate_id",
    "candidate_revision",
    "evaluation_baseline",
    "source_manifest_digest",
    "kept_roots",
    "dropped_roots",
    "projected_manifest_digest",
    "recorded_at_utc",
    "projection_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-upgrade-evidence-manifest-projection/v1"
    },
    "campaign_id": {
      "$ref": "#/$defs/safeId"
    },
    "candidate_id": {
      "$ref": "#/$defs/safeId"
    },
    "candidate_revision": {
      "type": "integer",
      "minimum": 1
    },
    "evaluation_baseline": {
      "type": "integer",
      "minimum": 1
    },
    "source_manifest_digest": {
      "$ref": "#/$defs/sha256"
    },
    "kept_roots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dropped_roots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "projected_manifest_digest": {
      "$ref": "#/$defs/sha256"
    },
    "recorded_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "projection_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}
