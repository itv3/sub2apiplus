{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/candidate-42-acceptance-v1.json",
  "title": "Codex CLI 0.145.0 候选侧 42 条规则验收提交",
  "description": "描述候选构建身份、逐规则实现位置、触发条件、官方证据、候选原始证据、已执行断言和环境恢复证据。文件存在性、摘要、规则全集和外部断言结果由严格验收器进一步校验。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "codex_version",
    "assessment_id",
    "generated_at",
    "rule_manifest_sha256",
    "candidate_identity",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-candidate-42-acceptance/v1"
    },
    "codex_version": {
      "const": "0.145.0"
    },
    "assessment_id": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "rule_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_identity": {
      "$ref": "#/$defs/candidateIdentity"
    },
    "rules": {
      "type": "array",
      "description": "必须与 codex_upgrade_rules_0_145_0.json 一一对应；验收器额外检查 ID 全集、顺序无关的缺失、重复和越界规则。",
      "minItems": 42,
      "maxItems": 42,
      "items": {
        "$ref": "#/$defs/ruleAcceptance"
      }
    }
  },
  "$defs": {
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "candidateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "source_tree_sha256",
        "image_reference",
        "image_digest",
        "deployed_version"
      ],
      "properties": {
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "image_reference": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "deployed_version": {
          "$ref": "#/$defs/nonEmptyText"
        }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "implementationLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "line_start", "line_end", "symbol"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "$ref": "#/$defs/nonEmptyText"
        }
      }
    },
    "officialArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "kind"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "kind": {
          "enum": [
            "application_log",
            "database_trace",
            "filesystem_snapshot",
            "http_trace",
            "mitm_jsonl",
            "official_analysis",
            "official_index",
            "official_report",
            "pcap",
            "pcapng",
            "process_trace",
            "relay_binary",
            "source_excerpt",
            "stderr_log",
            "stdout_log",
            "tls_keylog",
            "websocket_trace",
            "wire_dump"
          ]
        }
      }
    },
    "candidateRawArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "kind"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "kind": {
          "enum": [
            "application_log",
            "database_trace",
            "filesystem_snapshot",
            "http_trace",
            "mitm_jsonl",
            "pcap",
            "pcapng",
            "process_trace",
            "relay_binary",
            "stderr_log",
            "stdout_log",
            "tls_keylog",
            "websocket_trace",
            "wire_dump"
          ]
        }
      }
    },
    "assertionResultReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "kind"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "kind": {
          "const": "assertion_result"
        }
      }
    },
    "normalizedStateArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "kind", "captured_at"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "kind": {
          "const": "normalized_state"
        },
        "captured_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyText"
      }
    },
    "ruleAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "implementation",
        "trigger",
        "official_evidence",
        "candidate_raw_evidence",
        "assertion",
        "environment_restoration"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^SPEC-[A-Z0-9]+-[0-9]{3}$"
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "locations"],
          "properties": {
            "summary": {
              "$ref": "#/$defs/nonEmptyText"
            },
            "locations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/implementationLocation"
              }
            }
          }
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "preconditions",
            "command",
            "expected_observation"
          ],
          "properties": {
            "description": {
              "$ref": "#/$defs/nonEmptyText"
            },
            "preconditions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/nonEmptyText"
              }
            },
            "command": {
              "$ref": "#/$defs/command"
            },
            "expected_observation": {
              "$ref": "#/$defs/nonEmptyText"
            }
          }
        },
        "official_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observation", "artifacts"],
          "properties": {
            "observation": {
              "$ref": "#/$defs/nonEmptyText"
            },
            "artifacts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/officialArtifact"
              }
            }
          }
        },
        "candidate_raw_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observation", "artifacts"],
          "properties": {
            "observation": {
              "$ref": "#/$defs/nonEmptyText"
            },
            "artifacts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/candidateRawArtifact"
              }
            }
          }
        },
        "assertion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checker", "command", "result"],
          "properties": {
            "checker": {
              "$ref": "#/$defs/sourceReference"
            },
            "command": {
              "$ref": "#/$defs/command"
            },
            "result": {
              "$ref": "#/$defs/assertionResultReference"
            }
          }
        },
        "environment_restoration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "state_pairs"],
          "properties": {
            "description": {
              "$ref": "#/$defs/nonEmptyText"
            },
            "state_pairs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "before", "after"],
                "properties": {
                  "name": {
                    "$ref": "#/$defs/nonEmptyText"
                  },
                  "before": {
                    "$ref": "#/$defs/normalizedStateArtifact"
                  },
                  "after": {
                    "$ref": "#/$defs/normalizedStateArtifact"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
