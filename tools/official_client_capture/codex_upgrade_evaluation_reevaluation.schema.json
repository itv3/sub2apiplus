{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-evaluation-reevaluation-v1.json",
  "title": "评估重评触发事实（第三批 B3-3：评估器／证据层修好并登记演进后，对已有评估产出的候选按新工具全量重评；tool-evolution 基线的 recovery.diagnosis 绑定它）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "campaign_manifest_sha256",
    "candidate_id",
    "candidate_revision",
    "from_baseline",
    "from_baseline_commit_sha256",
    "tool_evolution_index",
    "evaluator_changed_fields",
    "evidence_from_sha256",
    "evidence_to_sha256",
    "authorized_evaluator_digests",
    "current_evaluator_digests",
    "evaluation_outputs",
    "reviewer",
    "reviewed_at_utc",
    "review_sha256",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-upgrade-evaluation-reevaluation/v1"
    },
    "campaign_id": {
      "$ref": "#/$defs/safeId"
    },
    "campaign_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_id": {
      "$ref": "#/$defs/safeId"
    },
    "candidate_revision": {
      "type": "integer",
      "minimum": 1
    },
    "from_baseline": {
      "type": "integer",
      "minimum": 0
    },
    "from_baseline_commit_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "tool_evolution_index": {
      "type": "integer",
      "minimum": 0
    },
    "evaluator_changed_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "checker_sha256",
          "builder_sha256",
          "compare_reader_sha256",
          "accept_reader_sha256"
        ]
      }
    },
    "evidence_from_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_to_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authorized_evaluator_digests": {
      "$ref": "#/$defs/evaluatorDigests"
    },
    "current_evaluator_digests": {
      "$ref": "#/$defs/evaluatorDigests"
    },
    "evaluation_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reviewed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "review_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "evaluatorDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checker_sha256",
        "builder_sha256",
        "compare_reader_sha256",
        "accept_reader_sha256"
      ],
      "properties": {
        "checker_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "builder_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "compare_reader_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "accept_reader_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
