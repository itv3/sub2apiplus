{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-job-rehearsal-receipt-v1.json",
  "title": "Codex 升级完整 Job ARM64 离线演练收据",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "observed_at_utc",
    "preflight_campaign",
    "execution_contract",
    "execution_contract_sha256",
    "runtime_identity_sha256",
    "job_count",
    "job_set_sha256",
    "facts",
    "producer"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-upgrade-job-rehearsal-receipt/v1"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "incremental-noop"
      ]
    },
    "observed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "preflight_campaign": {
      "$ref": "#/$defs/preflightCampaign"
    },
    "execution_contract": {
      "$ref": "#/$defs/executionContract"
    },
    "execution_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_identity_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "storage_probe_sha256": {
      "description": "当前 P0 对登记 runs/runtime 子挂载执行同源可写，并对失败证据执行容器创建、宿主归档、双别名读取和有界清理探针的摘要；历史收据可缺省，新 Formal 必须由运行时门禁要求该字段。",
      "$ref": "#/$defs/sha256"
    },
    "failure_lifecycle_probe_sha256": {
      "description": "当前 P0 在 ARM64 生产挂载拓扑和 bubblewrap 零网络中，经 campaign-run v2、父 CampaignLease、真实 Job 三次失败、内部重试、三份宿主归档、双容器别名验证、父监督器终态审计和有界清理所得摘要；历史收据可缺省，新 Formal 必须由运行时门禁要求该字段。",
      "$ref": "#/$defs/sha256"
    },
    "job_count": {
      "type": "integer",
      "minimum": 1
    },
    "job_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "facts": {
      "description": "facts 文件中的 jobs[] 由运行时 finalizer 按闭集合校验；失败项必须含 error，可选 duration_seconds 必须为有限非负数。",
      "$ref": "#/$defs/binding"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "failed_job_ids": {
      "$ref": "#/$defs/jobIdArray"
    },
    "executed_job_ids": {
      "$ref": "#/$defs/jobIdArray"
    },
    "reused_job_ids": {
      "$ref": "#/$defs/jobIdArray"
    },
    "affected_job_ids": {
      "$ref": "#/$defs/jobIdArray"
    },
    "incremental_plan": {
      "$ref": "#/$defs/incrementalPlan"
    },
    "checkpoint": {
      "$ref": "#/$defs/checkpoint"
    },
    "incremental_noop": {
      "$ref": "#/$defs/incrementalNoop"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "incremental-noop"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["incremental_noop"],
        "properties": {
          "runtime_identity_sha256": {
            "type": "null"
          },
          "failed_job_ids": {
            "const": []
          },
          "executed_job_ids": {
            "const": []
          },
          "affected_job_ids": {
            "const": []
          }
        }
      },
      "else": {
        "properties": {
          "runtime_identity_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "jobIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/safeId"
      }
    },
    "componentName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "incrementalPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_sha256",
        "execute_job_ids",
        "reused_job_ids",
        "failed_job_ids",
        "changed_components",
        "reasons",
        "plan_sha256",
        "affected_job_ids",
        "previous_receipt"
      ],
      "properties": {
        "schema_version": {
          "const": "codex-upgrade-incremental/v1"
        },
        "contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "execute_job_ids": {
          "$ref": "#/$defs/jobIdArray"
        },
        "reused_job_ids": {
          "$ref": "#/$defs/jobIdArray"
        },
        "failed_job_ids": {
          "$ref": "#/$defs/jobIdArray"
        },
        "affected_job_ids": {
          "$ref": "#/$defs/jobIdArray"
        },
        "changed_components": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentName"
          }
        },
        "reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "previous_receipt": {
          "oneOf": [
            {
              "$ref": "#/$defs/binding"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "record_count",
        "last_sequence",
        "last_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        },
        "last_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "last_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "incrementalNoop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "new_pass_fact",
        "planned_job_ids",
        "execute_job_ids",
        "reused_job_ids",
        "affected_job_ids",
        "failed_job_ids",
        "changed_components",
        "plan_sha256",
        "source_receipt",
        "source_root",
        "source_status",
        "source_job_count",
        "source_job_set_sha256",
        "scanned_bytes",
        "live_request_count",
        "recorded_at_utc"
      ],
      "properties": {
        "schema_version": {
          "const": "codex-upgrade-incremental-noop/v1"
        },
        "new_pass_fact": {
          "const": false
        },
        "planned_job_ids": {
          "$ref": "#/$defs/jobIdArray"
        },
        "execute_job_ids": {
          "const": []
        },
        "reused_job_ids": {
          "$ref": "#/$defs/jobIdArray"
        },
        "affected_job_ids": {
          "const": []
        },
        "failed_job_ids": {
          "const": []
        },
        "changed_components": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentName"
          }
        },
        "plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_receipt": {
          "$ref": "#/$defs/binding"
        },
        "source_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "source_status": {
          "const": "passed"
        },
        "source_job_count": {
          "type": "integer",
          "minimum": 1
        },
        "source_job_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "scanned_bytes": {
          "const": 0
        },
        "live_request_count": {
          "const": 0
        },
        "recorded_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "preflightCampaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "campaign_id",
        "manifest_sha256",
        "campaign_mode"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "campaign_id": {
          "$ref": "#/$defs/safeId"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "campaign_mode": {
          "const": "preflight_only"
        }
      }
    },
    "phaseCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official",
        "candidate"
      ],
      "properties": {
        "official": {
          "type": "integer",
          "minimum": 0
        },
        "candidate": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_image",
        "model",
        "lite_model",
        "capture_root",
        "capture_container",
        "service_container",
        "keeper_container",
        "postgres_container",
        "redis_container",
        "capture_codex_bin",
        "relay_codex_bin",
        "capture_code_mode_host_bin",
        "relay_code_mode_host_bin"
      ],
      "properties": {
        "runtime_image": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:+-]*@sha256:[0-9a-f]{64}$"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "lite_model": {
          "type": "string",
          "minLength": 1
        },
        "capture_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "capture_container": {
          "$ref": "#/$defs/safeId"
        },
        "service_container": {
          "$ref": "#/$defs/safeId"
        },
        "keeper_container": {
          "$ref": "#/$defs/safeId"
        },
        "postgres_container": {
          "$ref": "#/$defs/safeId"
        },
        "redis_container": {
          "$ref": "#/$defs/safeId"
        },
        "capture_codex_bin": {
          "$ref": "#/$defs/absolutePath"
        },
        "relay_codex_bin": {
          "$ref": "#/$defs/absolutePath"
        },
        "capture_code_mode_host_bin": {
          "$ref": "#/$defs/absolutePath"
        },
        "relay_code_mode_host_bin": {
          "$ref": "#/$defs/absolutePath"
        }
      }
    },
    "c2paIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_job_id",
        "expectation"
      ],
      "properties": {
        "scenario_job_id": {
          "$ref": "#/$defs/safeId"
        },
        "expectation": {
          "enum": [
            "negative",
            "positive"
          ]
        }
      }
    },
    "executionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "target_version",
        "target_sha256",
        "target_package_sha256",
        "target_code_mode_host_sha256",
        "suite",
        "tool_files_sha256",
        "target_scenario_sha256",
        "evidence_label_declaration_sha256",
        "extra_jobs_sha256",
        "configuration",
        "job_count",
        "phase_counts",
        "job_ids",
        "job_phases",
        "step_counts",
        "job_templates_sha256",
        "c2pa_job_identities"
      ],
      "properties": {
        "schema_version": {
          "const": "codex-upgrade-job-rehearsal-contract/v2"
        },
        "target_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "target_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "target_package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "target_code_mode_host_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "suite": {
          "enum": [
            "core",
            "full"
          ]
        },
        "tool_files_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "target_scenario_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_label_declaration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "extra_jobs_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "configuration": {
          "$ref": "#/$defs/configuration"
        },
        "job_count": {
          "type": "integer",
          "minimum": 1
        },
        "phase_counts": {
          "$ref": "#/$defs/phaseCounts"
        },
        "job_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeId"
          }
        },
        "job_phases": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "official",
              "candidate"
            ]
          }
        },
        "step_counts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "job_templates_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "c2pa_job_identities": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/c2paIdentity"
          }
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tool",
        "tool_sha256",
        "version"
      ],
      "properties": {
        "schema_version": {
          "const": "codex-upgrade-job-rehearsal-producer/v1"
        },
        "tool": {
          "$ref": "#/$defs/absolutePath"
        },
        "tool_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "version": {
          "const": "1"
        }
      }
    }
  }
}
