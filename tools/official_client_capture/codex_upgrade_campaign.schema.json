{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-campaign-v3.json",
  "title": "Codex 出站版本升级 Campaign 不可变核心清单",
  "description": "Campaign 创建时只写一次，并由 campaign.sha256 封存。后续状态、候选身份、比较结果和验收门禁只能写入独立阶段收据，禁止回写本清单。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "created_at_utc",
    "campaign_mode",
    "campaign_purpose",
    "baseline_version",
    "target_version",
    "target_sha256",
    "suite",
    "official_identity",
    "baseline_identity",
    "tool_identity",
    "control_receipts",
    "inputs",
    "analysis",
    "configuration",
    "required_rules",
    "coverage_plan",
    "jobs"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "codex-upgrade-campaign/v3"
    },
    "campaign_id": {
      "$ref": "#/$defs/safeId"
    },
    "created_at_utc": {
      "$ref": "#/$defs/timestamp"
    },
    "campaign_mode": {
      "enum": [
        "preflight_only",
        "formal"
      ]
    },
    "campaign_purpose": {
      "$ref": "#/$defs/candidatePurpose"
    },
    "baseline_version": {
      "$ref": "#/$defs/version"
    },
    "target_version": {
      "$ref": "#/$defs/version"
    },
    "target_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "suite": {
      "enum": [
        "core",
        "full"
      ]
    },
    "official_identity": {
      "$ref": "#/$defs/officialIdentity"
    },
    "baseline_identity": {
      "$ref": "#/$defs/sourceIdentity"
    },
    "tool_identity": {
      "$ref": "#/$defs/toolIdentity"
    },
    "control_receipts": {
      "$ref": "#/$defs/controlReceipts"
    },
    "vc_control": {
      "$ref": "#/$defs/vcControl"
    },
    "predecessor": {
      "$ref": "#/$defs/predecessor"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "configuration": {
      "$ref": "#/$defs/configuration"
    },
    "required_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ruleId"
      }
    },
    "coverage_plan": {
      "$ref": "#/$defs/coveragePlan"
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/plannedJob"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "campaign_mode": {
            "const": "formal"
          }
        },
        "required": [
          "campaign_mode"
        ]
      },
      "then": {
        "properties": {
          "control_receipts": {
            "required": [
              "upgrade_timing",
              "arm64_environment",
              "job_rehearsal"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "control_receipts": {
            "not": {
              "required": [
                "job_rehearsal"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "candidatePurpose": {
      "enum": [
        "validation_only",
        "production_replacement"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ruleId": {
      "type": "string",
      "pattern": "^SPEC-[A-Z0-9]+-[0-9]{3}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/"
    },
    "gitCommit": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "nullableFileBinding": {
      "oneOf": [
        {
          "$ref": "#/$defs/fileBinding"
        },
        {
          "type": "null"
        }
      ]
    },
    "vcControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_plan",
        "vc0_checkpoint",
        "first_formal_batch",
        "first_campaign_run_manifest"
      ],
      "properties": {
        "campaign_plan": {
          "$ref": "#/$defs/fileBinding"
        },
        "vc0_checkpoint": {
          "$ref": "#/$defs/fileBinding"
        },
        "first_formal_batch": {
          "$ref": "#/$defs/nullableFileBinding"
        },
        "first_campaign_run_manifest": {
          "$ref": "#/$defs/nullableFileBinding"
        }
      }
    },
    "fileBindingWithBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "controlReceipts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upgrade_timing",
        "arm64_environment"
      ],
      "properties": {
        "upgrade_timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ledger_dir",
            "ledger_plan_sha256",
            "receipt",
            "upgrade_id",
            "evidence_decision",
            "checkpoint_head_sha256"
          ],
          "properties": {
            "ledger_dir": {
              "$ref": "#/$defs/absolutePath"
            },
            "ledger_plan_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "receipt": {
              "$ref": "#/$defs/fileBindingWithBytes"
            },
            "upgrade_id": {
              "$ref": "#/$defs/safeId"
            },
            "evidence_decision": {
              "enum": [
                "reuse",
                "recapture"
              ]
            },
            "checkpoint_head_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "arm64_environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_root",
            "receipt",
            "subject_id",
            "contract_sha256",
            "continuity_identity_sha256"
          ],
          "properties": {
            "evidence_root": {
              "$ref": "#/$defs/absolutePath"
            },
            "receipt": {
              "$ref": "#/$defs/fileBindingWithBytes"
            },
            "subject_id": {
              "$ref": "#/$defs/safeId"
            },
            "contract_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "continuity_identity_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "job_rehearsal": {
          "$ref": "#/$defs/jobRehearsalControl"
        },
        "p0_gate": {
          "$ref": "#/$defs/p0GateControl"
        }
      }
    },
    "p0GateControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_root", "receipt", "receipt_digest", "upgrade_id"],
      "properties": {
        "evidence_root": {"$ref": "#/$defs/absolutePath"},
        "receipt": {"$ref": "#/$defs/fileBindingWithBytes"},
        "receipt_digest": {"$ref": "#/$defs/sha256"},
        "upgrade_id": {"$ref": "#/$defs/safeId"}
      }
    },
    "jobRehearsalControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_root",
        "receipt",
        "preflight_campaign_id",
        "preflight_campaign_manifest_sha256",
        "execution_contract_sha256",
        "runtime_identity_sha256",
        "job_count",
        "job_set_sha256"
      ],
      "properties": {
        "evidence_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "receipt": {
          "$ref": "#/$defs/fileBindingWithBytes"
        },
        "preflight_campaign_id": {
          "$ref": "#/$defs/safeId"
        },
        "preflight_campaign_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "execution_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "job_count": {
          "type": "integer",
          "minimum": 1
        },
        "job_set_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_dir",
        "campaign_id",
        "campaign_manifest_sha256",
        "reason"
      ],
      "properties": {
        "campaign_dir": {
          "$ref": "#/$defs/absolutePath"
        },
        "campaign_id": {
          "$ref": "#/$defs/safeId"
        },
        "campaign_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reason": {
          "enum": [
            "candidate_failed_job_tool_recovery",
            "candidate_recovery_control_refresh",
            "candidate_recovery_control_replacement",
            "candidate_runtime_identity_correction",
            "classification_fact_correction",
            "sealed_stage_control_recovery",
            "official_evidence_reuse"
          ]
        }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source_tree_sha256",
        "egress_inventory_sha256",
        "cargo_lock_sha256",
        "git_commit"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "source_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "egress_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "cargo_lock_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "git_commit": {
          "$ref": "#/$defs/gitCommit"
        }
      }
    },
    "officialIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cli_version",
        "binary_sha256",
        "package",
        "source_tree_sha256",
        "cargo_lock_sha256",
        "git_commit",
        "runtime_image",
        "operating_system",
        "architecture",
        "tls_dependencies_sha256"
      ],
      "properties": {
        "cli_version": {
          "$ref": "#/$defs/version"
        },
        "binary_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "package": {
          "$ref": "#/$defs/officialPackage"
        },
        "source_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "cargo_lock_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "git_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "runtime_image": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "operating_system": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "architecture": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "tls_dependencies_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "officialPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_sha256",
        "layout_version",
        "target",
        "variant",
        "entrypoint",
        "binary_sha256",
        "code_mode_host_sha256"
      ],
      "properties": {
        "asset_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "layout_version": {
          "const": 1
        },
        "target": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "variant": {
          "const": "codex"
        },
        "entrypoint": {
          "const": "bin/codex"
        },
        "binary_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "code_mode_host_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "toolFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "entry_count",
        "files_sha256",
        "entries",
        "production_count",
        "production_sha256",
        "evaluation_count",
        "evaluation_sha256"
      ],
      "properties": {
        "git_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "entry_count": {
          "type": "integer",
          "minimum": 1
        },
        "files_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/toolFile"
          }
        },
        "production_count": {
          "type": "integer",
          "minimum": 1
        },
        "production_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evaluation_count": {
          "type": "integer",
          "minimum": 1
        },
        "evaluation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "components": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/componentIdentity"
          }
        },
        "component_identity_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "componentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_count",
        "entries",
        "sha256"
      ],
      "properties": {
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolFile"
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_rules",
        "discovery_scenarios",
        "extra_jobs"
      ],
      "properties": {
        "baseline_rules": {
          "$ref": "#/$defs/fileBinding"
        },
        "discovery_scenarios": {
          "$ref": "#/$defs/fileBinding"
        },
        "target_discovery_scenarios": {
          "$ref": "#/$defs/fileBinding"
        },
        "extra_jobs": {
          "$ref": "#/$defs/nullableFileBinding"
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline-source",
        "target-source",
        "source-diff",
        "baseline-surface"
      ],
      "properties": {
        "baseline-source": {
          "$ref": "#/$defs/fileBinding"
        },
        "target-source": {
          "$ref": "#/$defs/fileBinding"
        },
        "source-diff": {
          "$ref": "#/$defs/fileBinding"
        },
        "baseline-surface": {
          "$ref": "#/$defs/fileBinding"
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_source",
        "target_source",
        "target_package",
        "baseline_evidence",
        "runtime_image",
        "model",
        "lite_model",
        "capture_root",
        "capture_container",
        "service_container",
        "keeper_container",
        "postgres_container",
        "redis_container",
        "capture_codex_bin",
        "relay_codex_bin",
        "capture_code_mode_host_bin",
        "relay_code_mode_host_bin",
        "codex_account_id",
        "api_key_id",
        "live_attestation_compose_dir",
        "live_attestation_compose_files"
      ],
      "properties": {
        "baseline_source": {
          "$ref": "#/$defs/absolutePath"
        },
        "target_source": {
          "$ref": "#/$defs/absolutePath"
        },
        "target_package": {
          "$ref": "#/$defs/absolutePath"
        },
        "baseline_evidence": {
          "$ref": "#/$defs/absolutePath"
        },
        "runtime_image": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "model": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "lite_model": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "capture_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "capture_container": {
          "$ref": "#/$defs/safeId"
        },
        "service_container": {
          "$ref": "#/$defs/safeId"
        },
        "keeper_container": {
          "$ref": "#/$defs/safeId"
        },
        "postgres_container": {
          "$ref": "#/$defs/safeId"
        },
        "redis_container": {
          "$ref": "#/$defs/safeId"
        },
        "capture_codex_bin": {
          "$ref": "#/$defs/absolutePath"
        },
        "relay_codex_bin": {
          "$ref": "#/$defs/absolutePath"
        },
        "capture_code_mode_host_bin": {
          "$ref": "#/$defs/absolutePath"
        },
        "relay_code_mode_host_bin": {
          "$ref": "#/$defs/absolutePath"
        },
        "codex_account_id": {
          "type": "integer",
          "minimum": 1
        },
        "api_key_id": {
          "type": "integer",
          "minimum": 1
        },
        "live_attestation_compose_dir": {
          "type": "string"
        },
        "live_attestation_compose_files": {
          "type": "string"
        }
      }
    },
    "coveragePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_rule_count",
        "official_unmapped",
        "candidate_unmapped"
      ],
      "properties": {
        "required_rule_count": {
          "type": "integer",
          "minimum": 1
        },
        "official_unmapped": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ruleId"
          }
        },
        "candidate_unmapped": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ruleId"
          }
        }
      }
    },
    "plannedStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "timeout"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyText"
          }
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "plannedJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phase",
        "description",
        "steps",
        "evidence_roots",
        "covers",
        "scenario_ids",
        "track",
        "model_id",
        "expected_use_responses_lite",
        "required_model_receipt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "phase": {
          "enum": [
            "official",
            "candidate"
          ]
        },
        "description": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/plannedStep"
          }
        },
        "evidence_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyText"
          }
        },
        "covers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ruleId"
          }
        },
        "scenario_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^A[0-9]{2}$"
          }
        },
        "track": {
          "enum": ["main", "lite"]
        },
        "model_id": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "expected_use_responses_lite": {
          "type": "boolean"
        },
        "required_model_receipt": {
          "type": "boolean"
        }
      }
    }
  }
}
