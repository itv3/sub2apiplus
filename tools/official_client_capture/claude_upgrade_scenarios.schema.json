{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/claude-upgrade-scenarios-v1.json",
  "title": "Claude Code 出站版本化场景清单",
  "description": "结构对齐 codex-upgrade-scenarios/v1：把目标 Claude Code 版本的证据场景、取证 Job 命令模板、证据根与规则覆盖从编排器代码移到不可变机器清单。场景来源是 FW-F v5 目录（与 v4 同一组 49 个矩阵维度与 79 个 probe，判定按 version_facts 绑定的版本事实取）：维度即证据场景，没有维度的 probe 归入 condition.* 条件场景；每个 probe 是一个取证步骤（claude_fw_e_relay.py capture），probe 归并为 Job。非主模型的模型能力取证另成步骤：中继仍跑基础 probe，步骤 probe_id 为「<模型>-<基础 probe>」，全部归入发现项场景 aux.model_capability。变量分 campaign（plan 时代入）与 step_runtime（取证动作体每步绑定）两种作用域。运行时校验见 claude_upgrade_plan.validate_scenario_manifest（不依赖第三方 JSON Schema 库，失败关闭）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claude_version",
    "profile_id",
    "source_spec",
    "rule_manifest",
    "probe_catalog",
    "version_facts",
    "variable_contract",
    "evidence_scenarios",
    "capture_jobs",
    "required_client_bindings",
    "required_boundary_checks"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "claude-upgrade-scenarios/v1"},
    "claude_version": {"$ref": "#/$defs/version"},
    "profile_id": {"$ref": "#/$defs/safeId"},
    "source_spec": {"$ref": "#/$defs/sourceBinding"},
    "rule_manifest": {"$ref": "#/$defs/ruleManifestBinding"},
    "probe_catalog": {"$ref": "#/$defs/probeCatalogBinding"},
    "version_facts": {"$ref": "#/$defs/versionFactsBinding"},
    "variable_contract": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/variable"}
    },
    "evidence_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceScenario"}
    },
    "capture_jobs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/captureJob"}
    },
    "required_client_bindings": {
      "description": "B4-01：三官方客户端正例里只能在 Mac 上驱动的两个，按 Codex 第三方客户端收据机制由 Mac 侧 claude_drive_desktop.py 驱动并产出收据，候选 seal 用 --client-evidence 核对；CLI 正例由候选 Job 承担。排序去重，恰好是这两项。",
      "type": "array",
      "items": {"enum": ["claude-desktop", "claude-vscode"]},
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "required_boundary_checks": {
      "description": "B4-01：attempt 级边界核对，候选 Job 之后、seal 之前执行，证据进 attempt 的 client 证据目录。codex-final-wire-isolation 用现有 Codex 候选采集脚本（不改）跑最小场景、Codex checker 只读判定零差异；third-party-ingress-rejection 核第三方与非法形态请求在读取 OAuth 凭据前被拒。排序去重，恰好是这两项。",
      "type": "array",
      "items": {"enum": ["codex-final-wire-isolation", "third-party-ingress-rejection"]},
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    }
  },
  "$defs": {
    "nonEmptyText": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "ruleId": {"type": "string", "pattern": "^SPEC-[A-Z0-9]+-[0-9]{3}$"},
    "scenarioId": {
      "description": "FW-F v4 矩阵维度（如 transport.native_tls）、没有维度的 probe 所归入的条件场景（condition.*），或非主模型取证的发现项场景 aux.model_capability。",
      "type": "string",
      "pattern": "^(?:transport|entrypoint|agency|header|body|tool|failure|aux|privacy|condition)\\.[a-z0-9_]+$"
    },
    "artifactKind": {"enum": ["relay_binary", "relay_manifest", "synthetic_intervention", "pcap", "debug_log"]},
    "sourceBinding": {
      "description": "绑定 Claude 手册第二部分（规则画像）的章节摘要：从标题行算到下一个一级标题之前。",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fragment", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "fragment": {"const": "第二部分"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "ruleManifestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "rule_count"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "rule_count": {"type": "integer", "minimum": 1}
      }
    },
    "versionFactsBinding": {
      "description": "FW-F v5 判定依赖的版本事实（claude-code-fw-f-v5-version-facts/v1）：仓库相对路径与文件摘要；每个步骤以 --fw-f-v5-version-facts／--fw-f-v5-version-facts-sha256 逐字携带同一份绑定。",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "probeCatalogBinding": {
      "description": "场景与步骤引用的 probe 目录；目录模块本身在 wire 层，随工具身份与逐作业依赖摘要冻结。probe_count 是目录的 probe 数（主模型步骤数），非主模型步骤不计入。",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema_version", "probe_count", "dimension_count"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "schema_version": {"const": "claude-code-fw-f-v5-scenario-catalog/v1"},
        "probe_count": {"type": "integer", "minimum": 1},
        "dimension_count": {"type": "integer", "minimum": 1}
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "sensitive", "scope", "description"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {"enum": ["string", "integer", "absolute_path", "sha256", "image_reference", "ip_address"]},
        "required": {"type": "boolean"},
        "sensitive": {"const": false},
        "scope": {
          "description": "campaign：plan 时由 Campaign 取值代入；step_runtime：取证动作体每步执行前绑定（宿主运行凭据与 nonce），plan 只保留占位，必须 required 且无默认值。",
          "enum": ["campaign", "step_runtime"]
        },
        "default": {"anyOf": [{"type": "string"}, {"type": "integer"}]},
        "description": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "evidenceScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "purpose", "description", "trigger", "preconditions", "probe_ids", "required_artifact_kinds", "covers"],
      "properties": {
        "scenario_id": {"$ref": "#/$defs/scenarioId"},
        "purpose": {
          "description": "rule_evidence 必须覆盖至少一条规则；discovery 是 2.1.226 实测未形成必需规则的发现项场景，covers 必须为空。",
          "enum": ["rule_evidence", "discovery"]
        },
        "description": {"$ref": "#/$defs/nonEmptyText"},
        "trigger": {"$ref": "#/$defs/nonEmptyText"},
        "preconditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyText"}},
        "probe_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/safeId"}},
        "required_artifact_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifactKind"}},
        "covers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ruleId"}}
      }
    },
    "commandStep": {
      "description": "一个 probe 的一次受管 R 取证：argv 必须调用 claude_fw_e_relay.py capture --execute，--probe-id 与 --fw-f-v5-probe 都等于 probe_id（主模型步骤，--model 为 {model}）或都等于基础 probe（非主模型步骤：probe_id 为「<--model 的字面模型名>-<基础 probe>」），--fw-f-v5-catalog 指向 {capture_tool_root}/capturelib/claude_fw_f_v5.py，--fw-f-v5-version-facts／--fw-f-v5-version-facts-sha256 等于顶层 version_facts 绑定，不得带 --fw-f-probe、--fw-f-v4-probe 或 --scenario；真实上游步骤带 --acknowledge-live-requests 与 --upstream-ip、以 docker exec {capture_container} 开头，合成步骤带 --acknowledge-synthetic-responses、不得带 --upstream-ip、以 docker exec {synthetic_capture_container}（断网容器）开头。",
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_id", "argv", "environment", "timeout_seconds"],
      "properties": {
        "probe_id": {"$ref": "#/$defs/safeId"},
        "argv": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyText"}},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "candidateCommandStep": {
      "description": "B4-01 候选步骤：argv 以 bash {capture_tool_root}/claude_run_candidate_capture.sh 开头，其后是在网关隔离环境里执行的中继候选模式命令 docker exec {capture_container} python3 {capture_tool_root}/claude_fw_e_relay.py capture --execute …（镜像主模型 official 步骤：同一 probe，--output-root 换到 runs/claude-candidate，去掉 --claude-credentials-file，加 --candidate-runtime-dir 与 --candidate-relay-port 18443）；environment 逐字给出脚本参数（CLAUDE_CANDIDATE_CAPTURE 开关、Campaign 目录、数据根、四个容器、候选账号与 API Key 的 ID、run-id、probe、输出根、运行目录、中继端口、触发方式与抓包 CA），与中继命令逐项一致。",
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_id", "argv", "environment", "timeout_seconds"],
      "properties": {
        "probe_id": {"$ref": "#/$defs/safeId"},
        "argv": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyText"}},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "captureJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phase",
        "suites",
        "scenario_ids",
        "description",
        "required",
        "steps",
        "evidence_roots",
        "covers",
        "required_scenario_receipts",
        "tool_dependencies"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/safeId"},
        "phase": {
          "description": "official：官方客户端直连取证（commandStep）；candidate（B4-01）：逐一镜像主模型 official probe 的候选网关取证（candidateCommandStep），按阶段各自闭合。",
          "enum": ["official", "candidate"]
        },
        "suites": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["core", "full"]}},
        "scenario_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/scenarioId"}},
        "description": {"$ref": "#/$defs/nonEmptyText"},
        "required": {"type": "boolean"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"anyOf": [{"$ref": "#/$defs/commandStep"}, {"$ref": "#/$defs/candidateCommandStep"}]}
        },
        "evidence_roots": {
          "description": "恰好一个证据根；各步 --output-root 是它下面以 probe 命名的子目录。",
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/nonEmptyText"}
        },
        "covers": {
          "description": "本作业证明的必需规则；只承载发现项场景的作业（非主模型的模型能力取证）为空。",
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ruleId"}
        },
        "required_scenario_receipts": {
          "description": "对齐 Codex 结构保留；Claude 尚未登记需要场景真实性收据的目标场景，只能为空。",
          "type": "array",
          "maxItems": 0
        },
        "tool_dependencies": {
          "description": "逐作业显式工具依赖（R16），由 tests/job_dependency_analyzer.py 生成：相对工具根的路径，排序去重，全部作业都必须声明。",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(?:/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"}
        }
      }
    }
  }
}
