{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-action-output-binding-v1.json",
  "title": "父监督器动作输出绑定（动作退出后、stop-receipt 前 write-once 写出：声明产物路径的存在性与摘要，checkpoints 目录记链 head）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "phase",
    "action_id",
    "run_manifest_sha256",
    "owner_nonce",
    "bindings",
    "recorded_at_utc",
    "binding_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-upgrade-action-output-binding/v1"
    },
    "campaign_id": {
      "$ref": "#/$defs/safeId"
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "action_id": {
      "$ref": "#/$defs/safeId"
    },
    "run_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "owner_nonce": {
      "$ref": "#/$defs/sha256"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "exists",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "exists": {
            "type": "boolean"
          },
          "sha256": {
            "oneOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "recorded_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "binding_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$)).+$"
    }
  }
}
