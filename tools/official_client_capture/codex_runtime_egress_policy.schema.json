{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-runtime-egress-policy-v1.json",
  "title": "受限运维出口策略",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "revision",
    "authorization",
    "services",
    "nodes",
    "allowed_public_ipv4",
    "probe_urls",
    "probe_quorum",
    "probe_refresh_seconds",
    "probe_max_age_seconds",
    "lease_seconds",
    "poll_seconds",
    "route_table",
    "rule_priority",
    "control_port"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-runtime-egress-policy/v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "authorized_at_utc",
        "reason"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "authorized_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cgroup_parent",
          "dns_servers",
          "dependencies",
          "ingress_tcp_ports"
        ],
        "properties": {
          "cgroup_parent": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+\\.slice$"
          },
          "dns_servers": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "ipv4"
            },
            "minItems": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "container",
                "protocol",
                "ports"
              ],
              "properties": {
                "container": {
                  "type": "string",
                  "minLength": 1
                },
                "protocol": {
                  "enum": [
                    "tcp",
                    "udp"
                  ]
                },
                "ports": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "minItems": 1
                }
              }
            }
          },
          "ingress_tcp_ports": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "exit"
      ],
      "properties": {
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interface",
            "tunnel_ipv4",
            "public_key",
            "endpoint",
            "listen_port",
            "mtu",
            "public_interface"
          ],
          "properties": {
            "interface": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,14}$"
            },
            "tunnel_ipv4": {
              "type": "string",
              "minLength": 1
            },
            "public_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]{43}=$"
            },
            "endpoint": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ipv4",
                "port"
              ],
              "properties": {
                "ipv4": {
                  "type": "string",
                  "format": "ipv4"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            },
            "listen_port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "mtu": {
              "type": "integer",
              "minimum": 1280,
              "maximum": 1500
            },
            "public_interface": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "exit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interface",
            "tunnel_ipv4",
            "public_key",
            "endpoint",
            "listen_port",
            "mtu",
            "public_interface"
          ],
          "properties": {
            "interface": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,14}$"
            },
            "tunnel_ipv4": {
              "type": "string",
              "minLength": 1
            },
            "public_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]{43}=$"
            },
            "endpoint": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ipv4",
                "port"
              ],
              "properties": {
                "ipv4": {
                  "type": "string",
                  "format": "ipv4"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            },
            "listen_port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "mtu": {
              "type": "integer",
              "minimum": 1280,
              "maximum": 1500
            },
            "public_interface": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "allowed_public_ipv4": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "ipv4"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "probe_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://"
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "probe_quorum": {
      "type": "integer",
      "minimum": 2
    },
    "probe_refresh_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "probe_max_age_seconds": {
      "type": "integer",
      "minimum": 2,
      "maximum": 60
    },
    "lease_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "poll_seconds": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 2.5
    },
    "route_table": {
      "type": "integer",
      "minimum": 256,
      "maximum": 2147483647
    },
    "rule_priority": {
      "type": "integer",
      "minimum": 10,
      "maximum": 30000
    },
    "control_port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    }
  }
}
