{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-rule-migration-v1.json",
  "title": "Codex 出站规则迁移清单",
  "description": "逐条闭合基线与目标规则，并对源码和官方动态形态的新增、移除 fingerprint 分别分类。inherit 只表示规则语义复用，目标版本仍须重新抓取和断言。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_version",
    "target_version",
    "status",
    "entries",
    "discovery_classifications"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "codex-upgrade-rule-migration/v1"
    },
    "baseline_version": {
      "$ref": "#/$defs/version"
    },
    "target_version": {
      "$ref": "#/$defs/version"
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/migrationEntry"
      }
    },
    "discovery_classifications": {
      "type": "array",
      "description": "必须与 source_diff 和 baseline_to_target_official 的 added/removed fingerprint 全集一一对应；编排器负责检查缺失、重复和越界项。",
      "items": {
        "$ref": "#/$defs/discoveryClassification"
      }
    }
  },
  "$defs": {
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ruleId": {
      "type": "string",
      "pattern": "^SPEC-[A-Z0-9]+-[0-9]{3}$"
    },
    "nullableRuleId": {
      "oneOf": [
        {
          "$ref": "#/$defs/ruleId"
        },
        {
          "type": "null"
        }
      ]
    },
    "classification": {
      "enum": [
        "inherit",
        "change",
        "add",
        "delete",
        "condition_change",
        "blocked"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyText"
      }
    },
    "migrationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_rule",
        "target_rule",
        "classification",
        "rationale",
        "evidence_refs"
      ],
      "properties": {
        "baseline_rule": {
          "$ref": "#/$defs/nullableRuleId"
        },
        "target_rule": {
          "$ref": "#/$defs/nullableRuleId"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "const": "add"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "baseline_rule": {
                "type": "null"
              },
              "target_rule": {
                "$ref": "#/$defs/ruleId"
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "delete"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "baseline_rule": {
                "$ref": "#/$defs/ruleId"
              },
              "target_rule": {
                "type": "null"
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "enum": [
                  "inherit",
                  "change",
                  "condition_change"
                ]
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "baseline_rule": {
                "$ref": "#/$defs/ruleId"
              },
              "target_rule": {
                "$ref": "#/$defs/ruleId"
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "blocked"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "baseline_rule": {
                    "$ref": "#/$defs/ruleId"
                  }
                }
              },
              {
                "properties": {
                  "target_rule": {
                    "$ref": "#/$defs/ruleId"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "discoveryClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "change",
        "fingerprint",
        "classification",
        "target_rule",
        "rationale",
        "evidence_refs"
      ],
      "properties": {
        "source": {
          "enum": [
            "source",
            "dynamic"
          ]
        },
        "change": {
          "enum": [
            "added",
            "removed"
          ]
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "target_rule": {
          "$ref": "#/$defs/nullableRuleId"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "evidence_refs": {
          "allOf": [
            {
              "$ref": "#/$defs/evidenceRefs"
            },
            {
              "type": "array",
              "minItems": 1
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "change": {
                "const": "added"
              }
            },
            "required": [
              "change"
            ]
          },
          "then": {
            "properties": {
              "classification": {
                "enum": [
                  "add",
                  "change",
                  "condition_change",
                  "blocked"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "change": {
                "const": "removed"
              }
            },
            "required": [
              "change"
            ]
          },
          "then": {
            "properties": {
              "classification": {
                "enum": [
                  "delete",
                  "change",
                  "condition_change",
                  "blocked"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "enum": [
                  "add",
                  "change",
                  "condition_change"
                ]
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "target_rule": {
                "$ref": "#/$defs/ruleId"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "delete"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "target_rule": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
