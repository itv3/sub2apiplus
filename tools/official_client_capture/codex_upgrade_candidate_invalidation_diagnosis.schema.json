{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/candidate-invalidation-diagnosis-v1.json",
  "title": "候选作废诊断收据（invalidate-candidate 由工具签发：绑定总账 head 与旧候选身份快照）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "campaign_manifest_sha256",
    "candidate_id",
    "revision",
    "reviewer",
    "reviewed_at_utc",
    "conclusion",
    "evidence_refs",
    "project_ledger_head_sha256",
    "project_ledger_head_sequence",
    "root_cause_id",
    "identity_snapshot",
    "review_sha256",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "candidate-invalidation-diagnosis/v1"
    },
    "campaign_id": {
      "$ref": "#/$defs/safeId"
    },
    "campaign_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_id": {
      "$ref": "#/$defs/safeId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reviewed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "conclusion": {
      "const": "candidate_source_change_required"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "project_ledger_head_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "project_ledger_head_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "root_cause_id": {
      "type": "string",
      "pattern": "^rc1-[0-9a-f]{20}$"
    },
    "identity_snapshot": {
      "$ref": "#/$defs/identitySnapshot"
    },
    "review_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "identitySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "source_tree_sha256",
        "image_id",
        "build_receipt_sha256",
        "snapshot_sources"
      ],
      "properties": {
        "git_commit": {
          "oneOf": [
            {
              "$ref": "#/$defs/gitCommit"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_tree_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "image_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "build_receipt_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "build_receipt",
              "attempt_candidate_identity",
              "candidate_source"
            ]
          }
        }
      }
    }
  }
}
