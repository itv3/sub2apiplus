{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/candidate-invalidation-diagnosis-v1.json",
  "title": "候选作废诊断收据（invalidate-candidate 由工具签发：绑定总账 head 与旧候选身份快照）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "campaign_manifest_sha256",
    "candidate_id",
    "revision",
    "reviewer",
    "reviewed_at_utc",
    "conclusion",
    "evidence_refs",
    "project_ledger_head_sha256",
    "project_ledger_head_sequence",
    "root_cause_id",
    "identity_snapshot",
    "review_sha256",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "candidate-invalidation-diagnosis/v1"
    },
    "campaign_id": {
      "$ref": "#/$defs/safeId"
    },
    "campaign_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_id": {
      "$ref": "#/$defs/safeId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reviewed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "conclusion": {
      "const": "candidate_source_change_required"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "project_ledger_head_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "project_ledger_head_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "root_cause_id": {
      "type": "string",
      "pattern": "^rc1-[0-9a-f]{20}$"
    },
    "identity_snapshot": {
      "$ref": "#/$defs/identitySnapshot"
    },
    "review_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "identitySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "source_tree_sha256",
        "image_id",
        "build_receipt_sha256",
        "snapshot_sources"
      ],
      "properties": {
        "git_commit": {
          "oneOf": [
            {
              "$ref": "#/$defs/gitCommit"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_tree_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "image_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "build_receipt_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "build_receipt",
              "attempt_candidate_identity",
              "candidate_source"
            ]
          }
        },
        "binary_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "image_digest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "build_parameters_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "build_inputs": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_tree_sha256",
                "go_mod_sha256",
                "go_sum_sha256",
                "vendor_sha256",
                "parameters_sha256",
                "requirements_sha256",
                "go_version",
                "node_version",
                "pnpm_version",
                "base_images",
                "target_architecture"
              ],
              "properties": {
                "source_tree_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "go_mod_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "go_sum_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "vendor_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "parameters_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "requirements_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "go_version": {
                  "type": "string",
                  "pattern": "^go[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:[a-z0-9.-]+)?$"
                },
                "node_version": {
                  "type": "string"
                },
                "pnpm_version": {
                  "type": "string"
                },
                "base_images": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ALPINE_IMAGE",
                    "POSTGRES_IMAGE",
                    "NODE_IMAGE"
                  ],
                  "properties": {
                    "ALPINE_IMAGE": {
                      "type": "string",
                      "pattern": "^.+@sha256:[0-9a-f]{64}$"
                    },
                    "POSTGRES_IMAGE": {
                      "type": "string",
                      "pattern": "^.+@sha256:[0-9a-f]{64}$"
                    },
                    "NODE_IMAGE": {
                      "type": "string",
                      "pattern": "^.+@sha256:[0-9a-f]{64}$"
                    }
                  }
                },
                "target_architecture": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "build_parameters_input_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "dependentRequired": {
        "binary_sha256": [
          "image_digest",
          "build_parameters_sha256",
          "build_parameters_input_sha256",
          "build_inputs"
        ],
        "image_digest": [
          "binary_sha256",
          "build_parameters_sha256",
          "build_parameters_input_sha256",
          "build_inputs"
        ],
        "build_parameters_sha256": [
          "binary_sha256",
          "image_digest",
          "build_parameters_input_sha256",
          "build_inputs"
        ],
        "build_inputs": [
          "binary_sha256",
          "image_digest",
          "build_parameters_sha256",
          "build_parameters_input_sha256"
        ],
        "build_parameters_input_sha256": [
          "binary_sha256",
          "image_digest",
          "build_parameters_sha256",
          "build_inputs"
        ]
      }
    }
  }
}
