{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-stage-replay-v1.json",
  "title": "Campaign 阶段动作幂等重派证明",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision", "campaign_id", "run_id", "review_event_id", "review_root_cause_id", "reconciliation_receipt_sha256", "commit_sha256", "next_action", "phase", "allowed", "actions", "reasons"],
  "properties": {
    "schema_version": {"const": "codex-upgrade-stage-replay/v1"},
    "decision": {"const": "recoverable"},
    "campaign_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "review_event_id": {"type": "string", "minLength": 1},
    "review_root_cause_id": {"type": "string", "minLength": 1},
    "reconciliation_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "commit_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "next_action": {"enum": ["redispatch-same-sequence", "redispatch-same-batch"]},
    "phase": {"enum": ["VC-1", "VC-2", "VC-3", "VC-4"]},
    "allowed": {"const": true},
    "actions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["action_id", "command", "inputs", "outputs"],
        "properties": {
          "action_id": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 3, "items": {"type": "string"}},
          "inputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
          "outputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}}
        }
      }
    },
    "reasons": {"type": "array", "maxItems": 0}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
