{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-egress-client-evidence-v1.json",
  "title": "Codex 出站第三方客户端交换证明",
  "description": "从 Sub2API 运行审计与 usage 审计导出的请求、响应结构化证明；两侧以 request_id 和 OAuth account ID 闭环。",
  "oneOf": [
    {
      "$ref": "#/$defs/requestEvidence"
    },
    {
      "$ref": "#/$defs/responseEvidence"
    }
  ],
  "$defs": {
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runNonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "imageId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "clientId": {
      "enum": [
        "kilo-compatible",
        "kilo-responses"
      ]
    },
    "requestEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "request_id",
        "campaign_id",
        "attempt_id",
        "run_nonce",
        "client_id",
        "client_version",
        "protocol",
        "entrypoint",
        "model",
        "candidate_id",
        "target_version",
        "auth_mode",
        "oauth_account_id",
        "profile_id",
        "profile_digest",
        "candidate_image_id",
        "upstream_endpoint",
        "transport",
        "affected_branches",
        "observed_at_utc"
      ],
      "properties": {
        "schema_version": {
          "const": "codex-egress-client-request-evidence/v1"
        },
        "source": {
          "const": "sub2api-runtime-audit"
        },
        "request_id": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "campaign_id": {
          "$ref": "#/$defs/safeId"
        },
        "attempt_id": {
          "$ref": "#/$defs/safeId"
        },
        "run_nonce": {
          "$ref": "#/$defs/runNonce"
        },
        "client_id": {
          "$ref": "#/$defs/clientId"
        },
        "client_version": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "protocol": {
          "enum": [
            "openai-compatible",
            "openai-responses"
          ]
        },
        "entrypoint": {
          "enum": [
            "/v1/chat/completions",
            "/v1/responses"
          ]
        },
        "model": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "candidate_id": {
          "$ref": "#/$defs/safeId"
        },
        "target_version": {
          "$ref": "#/$defs/version"
        },
        "auth_mode": {
          "const": "oauth"
        },
        "oauth_account_id": {
          "type": "integer",
          "minimum": 1
        },
        "profile_id": {
          "$ref": "#/$defs/safeId"
        },
        "profile_digest": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_image_id": {
          "$ref": "#/$defs/imageId"
        },
        "upstream_endpoint": {
          "type": "string",
          "pattern": "^/"
        },
        "transport": {
          "enum": [
            "http",
            "websocket"
          ]
        },
        "affected_branches": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "http",
              "websocket",
              "lite",
              "models",
              "cache",
              "prewarm",
              "fallback"
            ]
          }
        },
        "observed_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "responseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "request_id",
        "campaign_id",
        "attempt_id",
        "run_nonce",
        "client_id",
        "candidate_id",
        "status",
        "http_status",
        "response_id",
        "usage_recorded",
        "usage_id",
        "usage_account_id",
        "completed_at_utc"
      ],
      "properties": {
        "schema_version": {
          "const": "codex-egress-client-response-evidence/v1"
        },
        "source": {
          "const": "sub2api-usage-audit"
        },
        "request_id": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "campaign_id": {
          "$ref": "#/$defs/safeId"
        },
        "attempt_id": {
          "$ref": "#/$defs/safeId"
        },
        "run_nonce": {
          "$ref": "#/$defs/runNonce"
        },
        "client_id": {
          "$ref": "#/$defs/clientId"
        },
        "candidate_id": {
          "$ref": "#/$defs/safeId"
        },
        "status": {
          "const": "success"
        },
        "http_status": {
          "type": "integer",
          "minimum": 200,
          "maximum": 299
        },
        "response_id": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "usage_recorded": {
          "const": true
        },
        "usage_id": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "usage_account_id": {
          "type": "integer",
          "minimum": 1
        },
        "completed_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
