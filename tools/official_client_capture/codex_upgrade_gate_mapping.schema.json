{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-post-promotion-gate-mapping-v2.json",
  "title": "Codex VC-4 post-promotion 门禁映射",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requirements_sha256", "gates"],
  "properties": {
    "schema_version": {"const": "codex-post-promotion-gate-mapping/v2"},
    "requirements_sha256": {"$ref": "#/$defs/sha256"},
    "gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/gate"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "test_id",
        "working_directory",
        "command",
        "requirement_sha256"
      ],
      "properties": {
        "gate_id": {"$ref": "#/$defs/safeId"},
        "test_id": {"$ref": "#/$defs/safeId"},
        "working_directory": {"enum": [".", "backend"]},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "requirement_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
