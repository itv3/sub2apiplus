{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-vc-action-plan-v1.json",
  "title": "Codex VC 后继批次动作计划",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execute_item_ids", "reuse_item_ids", "actions"],
  "properties": {
    "schema_version": {"const": "codex-upgrade-vc-action-plan/v1"},
    "execute_item_ids": {"$ref": "#/$defs/idArray"},
    "reuse_item_ids": {"$ref": "#/$defs/idArray"},
    "actions": {"$ref": "#/$defs/actions"}
  },
  "$defs": {
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "idArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/safeId"}},
    "actions": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["action_id", "operation", "timeout_seconds", "command", "item_ids"],
        "properties": {
          "action_id": {"$ref": "#/$defs/safeId"},
          "operation": {"type": "string", "minLength": 1, "maxLength": 256},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
          "command": {
            "type": "array", "minItems": 1, "maxItems": 64,
            "items": {"type": "string", "minLength": 1, "maxLength": 4096}
          },
          "item_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"$ref": "#/$defs/safeId"}
          }
        }
      }
    }
  }
}
