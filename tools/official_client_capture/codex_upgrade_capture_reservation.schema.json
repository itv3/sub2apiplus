{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-capture-reservation-v3.json",
  "title": "Codex 出站抓包原子预约",
  "description": "run 发出请求前在 Campaign 锁内原子发布，用于关闭并发竞态和进程中断空目录窗口。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "campaign_mode",
    "campaign_purpose",
    "campaign_manifest_sha256",
    "phase",
    "candidate_id",
    "candidate_purpose",
    "attempt_id",
    "run_nonce",
    "started_at_utc",
    "identity_sha256",
    "planned_jobs",
    "candidate_readiness",
    "reservation_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-upgrade-capture-reservation/v3"
    },
    "campaign_id": {
      "$ref": "#/$defs/safeId"
    },
    "campaign_mode": {
      "const": "formal"
    },
    "campaign_purpose": {
      "$ref": "#/$defs/candidatePurpose"
    },
    "campaign_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "phase": {
      "const": "candidate"
    },
    "candidate_id": {
      "$ref": "#/$defs/safeId"
    },
    "candidate_purpose": {
      "$ref": "#/$defs/candidatePurpose"
    },
    "attempt_id": {
      "$ref": "#/$defs/attemptId"
    },
    "run_nonce": {
      "$ref": "#/$defs/sha256"
    },
    "started_at_utc": {
      "$ref": "#/$defs/rfc3339"
    },
    "identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "planned_jobs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "execution_sha256"],
        "properties": {
          "id": {"$ref": "#/$defs/safeId"},
          "required": {"type": "boolean"},
          "execution_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "campaign_lease": {
      "description": "创建预约时绑定的 Campaign 持久租约摘要；不复制可变租约正文。",
      "$ref": "#/$defs/campaignLeaseBinding"
    },
    "candidate_readiness": {
      "$ref": "#/$defs/candidateReadinessBinding"
    },
    "reservation_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "candidatePurpose": {
      "enum": ["validation_only", "production_replacement"]
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{16}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time"
    },
    "campaignLeaseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "owner_nonce", "deadline_at_utc"],
      "properties": {
        "path": {
          "const": ".campaign-lease.json"
        },
        "owner_nonce": {
          "$ref": "#/$defs/sha256"
        },
        "deadline_at_utc": {
          "$ref": "#/$defs/rfc3339"
        }
      }
    },
    "receiptBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "receipt_digest"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^control/candidate-readiness/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/.+\\.json$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "receipt_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidateReadinessBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "image_id",
        "build_receipt_sha256",
        "static_receipt",
        "models_probe_receipt",
        "project_head_sequence",
        "project_head_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "codex-upgrade-candidate-readiness-binding/v1"
        },
        "image_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "build_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "static_receipt": {"$ref": "#/$defs/receiptBinding"},
        "models_probe_receipt": {"$ref": "#/$defs/receiptBinding"},
        "project_head_sequence": {"type": "integer", "minimum": 0},
        "project_head_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
