{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-capture-reservation-v2.json",
  "title": "Codex 出站抓包原子预约",
  "description": "run 发出请求前在 Campaign 锁内原子发布，用于关闭并发竞态和进程中断空目录窗口。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "campaign_mode",
    "campaign_purpose",
    "campaign_manifest_sha256",
    "phase",
    "candidate_id",
    "candidate_purpose",
    "attempt_id",
    "run_nonce",
    "started_at_utc",
    "identity_sha256",
    "planned_jobs",
    "reservation_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-upgrade-capture-reservation/v2"
    },
    "campaign_id": {
      "$ref": "#/$defs/safeId"
    },
    "campaign_mode": {
      "const": "formal"
    },
    "campaign_purpose": {
      "$ref": "#/$defs/candidatePurpose"
    },
    "campaign_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "phase": {
      "enum": ["official", "candidate"]
    },
    "candidate_id": {
      "oneOf": [
        {"$ref": "#/$defs/safeId"},
        {"type": "null"}
      ]
    },
    "candidate_purpose": {
      "oneOf": [
        {"$ref": "#/$defs/candidatePurpose"},
        {"type": "null"}
      ]
    },
    "attempt_id": {
      "$ref": "#/$defs/attemptId"
    },
    "run_nonce": {
      "$ref": "#/$defs/sha256"
    },
    "started_at_utc": {
      "$ref": "#/$defs/rfc3339"
    },
    "identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "planned_jobs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "execution_sha256"],
        "properties": {
          "id": {"$ref": "#/$defs/safeId"},
          "required": {"type": "boolean"},
          "execution_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "reservation_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"phase": {"const": "official"}},
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "candidate_id": {"const": null},
          "candidate_purpose": {"const": null}
        }
      }
    },
    {
      "if": {
        "properties": {"phase": {"const": "candidate"}},
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "candidate_id": {"$ref": "#/$defs/safeId"},
          "candidate_purpose": {"$ref": "#/$defs/candidatePurpose"}
        }
      }
    }
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "candidatePurpose": {
      "enum": ["validation_only", "production_replacement"]
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{16}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time"
    }
  }
}
