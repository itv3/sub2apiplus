{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-arm64-environment-receipt-v1.json",
  "title": "Codex 升级 ARM64 环境收据（v6／v7 只读重放，v8 外部出口策略与等价投影）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "phase",
    "subject_id",
    "observed_at_utc",
    "contract_sha256",
    "continuity_identity_sha256",
    "resource_gate",
    "facts",
    "producer"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-upgrade-arm64-environment-receipt/v1"
    },
    "status": {
      "const": "passed"
    },
    "phase": {
      "enum": [
        "p0",
        "attempt_before",
        "attempt_after",
        "kilo_before",
        "kilo_after",
        "gate_before",
        "gate_after",
        "canary_before",
        "canary_after",
        "deployment_before",
        "deployment_after"
      ]
    },
    "subject_id": {
      "$ref": "#/$defs/safeId"
    },
    "observed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "continuity_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "resource_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used_percent",
        "available_bytes",
        "passed"
      ],
      "properties": {
        "used_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "available_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "boolean"
        },
        "degraded": {
          "const": true
        }
      }
    },
    "facts": {
      "$ref": "#/$defs/binding"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tool",
        "tool_sha256",
        "version"
      ],
      "properties": {
        "schema_version": {
          "const": "codex-upgrade-arm64-environment-producer/v1"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "tool_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "version": {
          "enum": [
            "6",
            "7",
            "8"
          ]
        }
      }
    },
    "environment_equivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "codex-arm64-environment-equivalence/v2"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtime_egress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_sha256",
        "status_sha256"
      ],
      "properties": {
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "producer v6：全部阶段保持硬门禁，只读重放。",
      "if": {
        "properties": {
          "producer": {
            "properties": {
              "version": {
                "const": "6"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "resource_gate": {
            "properties": {
              "used_percent": {
                "maximum": 69
              },
              "available_bytes": {
                "minimum": 32212254720
              },
              "passed": {
                "const": true
              }
            },
            "not": {
              "required": [
                "degraded"
              ]
            }
          }
        }
      }
    },
    {
      "$comment": "producer v7／v8 准入阶段（p0／*_before）：硬门禁。",
      "if": {
        "properties": {
          "producer": {
            "properties": {
              "version": {
                "enum": [
                  "7",
                  "8"
                ]
              }
            }
          },
          "phase": {
            "enum": [
              "p0",
              "attempt_before",
              "kilo_before",
              "gate_before",
              "canary_before",
              "deployment_before"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "resource_gate": {
            "properties": {
              "used_percent": {
                "maximum": 69
              },
              "available_bytes": {
                "minimum": 32212254720
              },
              "passed": {
                "const": true
              }
            },
            "not": {
              "required": [
                "degraded"
              ]
            }
          }
        }
      }
    },
    {
      "$comment": "producer v7／v8 收尾阶段（*_after）：低于水位记 degraded，收据仍通过。",
      "if": {
        "properties": {
          "producer": {
            "properties": {
              "version": {
                "enum": [
                  "7",
                  "8"
                ]
              }
            }
          },
          "phase": {
            "enum": [
              "attempt_after",
              "kilo_after",
              "gate_after",
              "canary_after",
              "deployment_after"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "resource_gate": {
            "oneOf": [
              {
                "properties": {
                  "used_percent": {
                    "maximum": 69
                  },
                  "available_bytes": {
                    "minimum": 32212254720
                  },
                  "passed": {
                    "const": true
                  }
                },
                "not": {
                  "required": [
                    "degraded"
                  ]
                }
              },
              {
                "required": [
                  "degraded"
                ],
                "properties": {
                  "passed": {
                    "const": false
                  },
                  "degraded": {
                    "const": true
                  }
                },
                "anyOf": [
                  {
                    "properties": {
                      "used_percent": {
                        "minimum": 70
                      }
                    }
                  },
                  {
                    "properties": {
                      "available_bytes": {
                        "maximum": 32212254719
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "producer": {
            "properties": {
              "version": {
                "const": "8"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "environment_equivalence",
          "runtime_egress"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "producer": {
            "properties": {
              "version": {
                "enum": [
                  "6",
                  "7"
                ]
              }
            }
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "environment_equivalence"
              ]
            },
            {
              "required": [
                "runtime_egress"
              ]
            }
          ]
        }
      }
    }
  ]
}
