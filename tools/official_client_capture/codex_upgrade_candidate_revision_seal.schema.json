{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-candidate-revision-seal-v1.json",
  "title": "候选级 revision seal（record-candidate-build 内 revision-seal 的结论：最终身份、VC-3 字节一致、同一性变化证明）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "revision",
    "candidate_id",
    "candidate_commit",
    "source_tree_sha256",
    "image_id",
    "build_receipt_sha256",
    "vc3_stage_receipt_sha256",
    "superseded",
    "identity_change",
    "sealed_at_utc",
    "seal_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-upgrade-candidate-revision-seal/v1"
    },
    "campaign_id": {
      "$ref": "#/$defs/safeId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "candidate_id": {
      "$ref": "#/$defs/safeId"
    },
    "candidate_commit": {
      "oneOf": [
        {
          "$ref": "#/$defs/gitCommit"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_tree_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "image_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "build_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "vc3_stage_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "superseded": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "candidate_id",
            "git_commit",
            "source_tree_sha256",
            "image_id"
          ],
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "candidate_id": {
              "$ref": "#/$defs/safeId"
            },
            "git_commit": {
              "oneOf": [
                {
                  "$ref": "#/$defs/gitCommit"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_tree_sha256": {
              "oneOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "image_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        }
      ]
    },
    "identity_change": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "git_commit_changed",
            "source_tree_changed",
            "image_changed"
          ],
          "properties": {
            "git_commit_changed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "source_tree_changed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "image_changed": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      ]
    },
    "sealed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "seal_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "identitySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "source_tree_sha256",
        "image_id",
        "build_receipt_sha256",
        "snapshot_sources"
      ],
      "properties": {
        "git_commit": {
          "oneOf": [
            {
              "$ref": "#/$defs/gitCommit"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_tree_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "image_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "build_receipt_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "build_receipt",
              "attempt_candidate_identity",
              "candidate_source"
            ]
          }
        }
      }
    }
  }
}
