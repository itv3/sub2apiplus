{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-evaluation-baseline-abandon-v1.json",
  "title": "评估基线 ABANDON（未 COMMIT 的 PREPARED 基线显式作废；编号作废不复用）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "candidate_id",
    "candidate_revision",
    "evaluation_baseline",
    "recovery_sha256",
    "reason",
    "abandoned_at_utc",
    "abandon_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-upgrade-evaluation-baseline-abandon/v1"
    },
    "campaign_id": {
      "$ref": "#/$defs/safeId"
    },
    "candidate_id": {
      "$ref": "#/$defs/safeId"
    },
    "candidate_revision": {
      "type": "integer",
      "minimum": 1
    },
    "evaluation_baseline": {
      "type": "integer",
      "minimum": 1
    },
    "recovery_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "abandoned_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "abandon_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}
