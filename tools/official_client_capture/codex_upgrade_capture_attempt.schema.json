{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-capture-attempt-v3.json",
  "title": "Codex 出站抓包不可变 Attempt",
  "description": "run 阶段只写一次的抓包事实；seal 只能引用其摘要，不能回写本文件。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "campaign_mode",
    "campaign_purpose",
    "phase",
    "candidate_id",
    "candidate_purpose",
    "status",
    "identity",
    "results",
    "evidence_roots",
    "evidence_permission_closeout",
    "evidence_permission_error",
    "environment",
    "binary_verification",
    "execution_error",
    "restoration_error",
    "next_gate",
    "campaign_manifest_sha256",
    "attempt_id",
    "run_nonce",
    "started_at_utc",
    "completed_at_utc",
    "reservation",
    "attempt_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-upgrade-capture-attempt/v3"
    },
    "campaign_id": {
      "$ref": "#/$defs/safeId"
    },
    "campaign_mode": {
      "const": "formal"
    },
    "campaign_purpose": {
      "$ref": "#/$defs/candidatePurpose"
    },
    "phase": {
      "enum": [
        "official",
        "candidate"
      ]
    },
    "candidate_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/safeId"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_purpose": {
      "oneOf": [
        {"$ref": "#/$defs/candidatePurpose"},
        {"type": "null"}
      ]
    },
    "status": {
      "enum": [
        "awaiting_receipts",
        "failed",
        "environment_contaminated"
      ]
    },
    "continuity": {
      "description": "复用历史 Job 时，对唯一来源 attempt 的环境连续性证明；无复用时为空。",
      "oneOf": [
        {"$ref": "#/$defs/attemptContinuity"},
        {"type": "null"}
      ]
    },
    "identity": {
      "oneOf": [
        {
          "$ref": "#/$defs/officialIdentity"
        },
        {
          "$ref": "#/$defs/candidateIdentity"
        }
      ]
    },
    "results": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/jobResult"
      }
    },
    "evidence_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/absolutePath"
      }
    },
    "evidence_permission_closeout": {
      "$ref": "#/$defs/nullableFileBindingWithBytes"
    },
    "evidence_permission_error": {
      "$ref": "#/$defs/nullableError"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "binary_verification": {
      "oneOf": [
        {
          "$ref": "#/$defs/binaryVerification"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_error": {
      "$ref": "#/$defs/nullableError"
    },
    "restoration_error": {
      "$ref": "#/$defs/nullableError"
    },
    "next_gate": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyText"
        },
        {
          "type": "null"
        }
      ]
    },
    "campaign_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{16}$"
    },
    "run_nonce": {
      "$ref": "#/$defs/sha256"
    },
    "started_at_utc": {
      "$ref": "#/$defs/rfc3339"
    },
    "completed_at_utc": {
      "$ref": "#/$defs/rfc3339"
    },
    "reservation": {
      "$ref": "#/$defs/fileBinding"
    },
    "attempt_digest": {
      "$ref": "#/$defs/sha256"
    },
    "tool_components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/componentIdentity"
      }
    },
    "incremental_tool_transition": {
      "$ref": "#/$defs/incrementalToolTransition"
    },
    "evaluation_transition": {
      "description": "评估工具 transition 的受控绑定；失败源 attempt 仅授权 capture-run，补跑闭集完成的新 attempt 承接同一绑定后才可进行离线 seal/compare/accept。",
      "$ref": "#/$defs/fileBinding"
    },
    "interrupted_recovery": {
      "description": "VC-1 父队列中断后，以零请求方式封口孤儿 attempt 的合同绑定。",
      "$ref": "#/$defs/interruptedRecovery"
    },
    "interrupted_recovery_transition": {
      "description": "恢复后继 attempt 对源孤儿 attempt 专用 transition 的只读绑定。",
      "$ref": "#/$defs/fileBinding"
    },
    "recovery_execution_handoff": {
      "description": "普通 VC-1 v2 零请求预览签发、并由紧邻真实补跑消费的不可变 handoff 绑定。",
      "$ref": "#/$defs/fileBinding"
    },
    "deadline_orphan_finalization": {
      "description": "原始总 deadline 强停后，由专用直接 finalizer 补齐环境终态、请求计数和停线绑定。",
      "$ref": "#/$defs/deadlineOrphanFinalization"
    },
    "classification_candidate_reuse_transition": {
      "description": "分类事实纠正后继对直接前序九项 Candidate 结果的零执行复用授权。",
      "$ref": "#/$defs/fileBinding"
    },
    "official_evidence_reuse_transition": {
      "description": "官方证据复用导入（A3a）：绑定当前 Campaign 的 predecessor-import.json，attempt 为零执行 metadata-only，results 是前序 awaiting_receipts official attempt 的坐标迁移投影。",
      "$ref": "#/$defs/fileBinding"
    },
    "incremental_plan": {
      "$ref": "#/$defs/attemptIncrementalPlan"
    },
    "watchdog": {
      "$ref": "#/$defs/watchdog"
    },
    "job_checkpoint": {
      "$ref": "#/$defs/jobCheckpoint"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "official"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "candidate_id": {
            "const": null
          },
          "candidate_purpose": {
            "const": null
          },
          "identity": {
            "$ref": "#/$defs/officialIdentity"
          },
          "binary_verification": {
            "$ref": "#/$defs/binaryVerification"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "candidate"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "candidate_id": {
            "$ref": "#/$defs/safeId"
          },
          "candidate_purpose": {
            "$ref": "#/$defs/candidatePurpose"
          },
          "identity": {
            "$ref": "#/$defs/candidateIdentity"
          },
          "binary_verification": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "status": {
                "const": "awaiting_receipts"
              }
            },
            "required": [
              "status"
            ]
          },
          {
            "not": {
              "required": [
                "classification_candidate_reuse_transition"
              ]
            }
          }
        ]
      },
      "then": {
        "properties": {
          "execution_error": {
            "type": "null"
          },
          "restoration_error": {
            "type": "null"
          },
          "next_gate": {
            "$ref": "#/$defs/nonEmptyText"
          },
          "environment": {
            "allOf": [
              {
                "$ref": "#/$defs/environment"
              },
              {
                "type": "object",
                "properties": {
                  "before_probe": {
                    "$ref": "#/$defs/fileBindingWithBytes"
                  },
                  "after_probe": {
                    "$ref": "#/$defs/fileBindingWithBytes"
                  },
                  "restoration_report": {
                    "$ref": "#/$defs/fileBindingWithBytes"
                  },
                  "arm64_before_receipt": {
                    "$ref": "#/$defs/fileBindingWithBytes"
                  },
                  "arm64_after_receipt": {
                    "$ref": "#/$defs/fileBindingWithBytes"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "classification_candidate_reuse_transition"
        ]
      },
      "then": {
        "required": [
          "incremental_plan",
          "watchdog",
          "job_checkpoint"
        ],
        "properties": {
          "phase": {
            "const": "candidate"
          },
          "status": {
            "const": "awaiting_receipts"
          },
          "binary_verification": {
            "type": "null"
          },
          "execution_error": {
            "type": "null"
          },
          "restoration_error": {
            "type": "null"
          },
          "environment": {
            "allOf": [
              {
                "$ref": "#/$defs/environment"
              },
              {
                "type": "object",
                "properties": {
                  "before_probe": {
                    "$ref": "#/$defs/fileBindingWithBytes"
                  },
                  "after_probe": {
                    "$ref": "#/$defs/fileBindingWithBytes"
                  },
                  "restoration_report": {
                    "$ref": "#/$defs/fileBindingWithBytes"
                  },
                  "arm64_before_receipt": {
                    "$ref": "#/$defs/fileBindingWithBytes"
                  },
                  "arm64_after_receipt": {
                    "$ref": "#/$defs/fileBindingWithBytes"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": ["interrupted_recovery"]
      },
      "then": {
        "properties": {
          "phase": {"const": "official"},
          "candidate_id": {"const": null},
          "candidate_purpose": {"const": null},
          "status": {"const": "failed"},
          "restoration_error": {"type": "null"}
        },
        "not": {
          "required": ["interrupted_recovery_transition"]
        }
      }
    },
    {
      "if": {
        "required": ["interrupted_recovery_transition"]
      },
      "then": {
        "properties": {
          "phase": {"const": "official"},
          "candidate_id": {"const": null},
          "candidate_purpose": {"const": null}
        },
        "not": {
          "required": ["interrupted_recovery"]
        }
      }
    },
    {
      "if": {
        "required": ["recovery_execution_handoff"]
      },
      "then": {
        "properties": {
          "phase": {"const": "official"},
          "candidate_id": {"const": null},
          "candidate_purpose": {"const": null}
        }
      }
    },
    {
      "if": {
        "required": ["deadline_orphan_finalization"]
      },
      "then": {
        "required": [
          "incremental_plan",
          "watchdog",
          "job_checkpoint",
          "interrupted_recovery_transition",
          "continuity"
        ],
        "properties": {
          "phase": {"const": "official"},
          "candidate_id": {"const": null},
          "candidate_purpose": {"const": null},
          "status": {"const": "failed"},
          "restoration_error": {"type": "null"}
        },
        "not": {
          "required": ["interrupted_recovery"]
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "interruptedRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "request_boundary"],
      "properties": {
        "contract": {"$ref": "#/$defs/fileBinding"},
        "request_boundary": {
          "const": {
            "reservation_exists": false,
            "live_request_count": 0,
            "scanned_bytes": 0
          }
        }
      }
    },
    "deadlineOrphanFinalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "live_request_audit",
        "request_accounting",
        "supervisor_terminal"
      ],
      "properties": {
        "contract": {"$ref": "#/$defs/fileBinding"},
        "live_request_audit": {"$ref": "#/$defs/fileBinding"},
        "request_accounting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "historical_live_request_count",
            "delta_live_request_count",
            "total_live_request_count",
            "finalizer_live_request_count",
            "failed_attempt_archives_enumerated"
          ],
          "properties": {
            "historical_live_request_count": {"type": "integer", "minimum": 0},
            "delta_live_request_count": {"type": "integer", "minimum": 0},
            "total_live_request_count": {"type": "integer", "minimum": 0},
            "finalizer_live_request_count": {"const": 0},
            "failed_attempt_archives_enumerated": {"const": false}
          }
        },
        "supervisor_terminal": {
          "const": {
            "state": "watchdog-aborted",
            "reason": "global-wall-clock-deadline-expired",
            "batch_sequence": 5
          }
        }
      }
    },
    "attemptContinuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_attempt_id",
        "compared_kinds",
        "source_after_probe_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "codex-upgrade-attempt-continuity/v1"
        },
        "source_attempt_id": {"$ref": "#/$defs/safeId"},
        "compared_kinds": {
          "const": ["service", "containers", "account", "configuration"]
        },
        "source_after_probe_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidatePurpose": {
      "enum": [
        "validation_only",
        "production_replacement"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "componentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_count",
        "entries",
        "sha256"
      ],
      "properties": {
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileBinding"
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "attemptIncrementalPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "planned_job_ids",
        "changed_components",
        "affected_job_ids",
        "reused_job_ids",
        "executed_job_ids",
        "failed_job_ids",
        "pending_job_ids",
        "plan_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "codex-upgrade-incremental/v1"
        },
        "planned_job_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safeId"}
        },
        "changed_components": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "affected_job_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeId"
          }
        },
        "reused_job_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeId"
          }
        },
        "executed_job_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeId"
          }
        },
        "failed_job_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeId"
          }
        },
        "pending_job_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeId"
          }
        },
        "plan_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "watchdog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "budget_seconds",
        "heartbeat_seconds",
        "elapsed_seconds",
        "remaining_seconds",
        "heartbeat",
        "timeout_checkpoint",
        "last_completed_job_id"
      ],
      "properties": {
        "schema_version": {
          "const": "codex-upgrade-watchdog-heartbeat/v1"
        },
        "budget_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "heartbeat_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "remaining_seconds": {
          "type": "number",
          "minimum": 0
        },
        "heartbeat": {
          "$ref": "#/$defs/nullableFileBindingWithBytes"
        },
        "timeout_checkpoint": {
          "$ref": "#/$defs/nullableFileBindingWithBytes"
        },
        "last_completed_job_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/safeId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "jobCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "record_count",
        "last_sequence",
        "last_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "codex-upgrade-job-checkpoint/v1"
        },
        "campaign_id": {
          "$ref": "#/$defs/safeId"
        },
        "phase": {
          "enum": ["official", "candidate"]
        },
        "attempt_id": {
          "$ref": "#/$defs/safeId"
        },
        "run_nonce": {
          "$ref": "#/$defs/sha256"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "last_sequence": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "last_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "incrementalToolTransition": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "phase",
        "from_component_identity_sha256",
        "to_component_identity_sha256",
        "changed_components",
        "changed_paths",
        "planned_job_ids",
        "affected_job_ids",
        "raw_evidence_scanned_bytes",
        "transition_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "codex-upgrade-incremental-tool-transition/v1"
        },
        "phase": {
          "enum": ["official", "candidate"]
        },
        "from_component_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "to_component_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "changed_components": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "changed_paths": {
          "type": "object"
        },
        "planned_job_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/safeId"}
        },
        "affected_job_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/safeId"}
        },
        "raw_evidence_scanned_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "transition_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "imageId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "immutableImage": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:+-]*@sha256:[0-9a-f]{64}$"
    },
    "gitCommit": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time"
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "ruleId": {
      "type": "string",
      "pattern": "^SPEC-[A-Z0-9]+-[0-9]{3}$"
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^A[0-9]{2}$"
    },
    "fileBindingWithBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "nullableFileBindingWithBytes": {
      "oneOf": [
        {
          "$ref": "#/$defs/fileBindingWithBytes"
        },
        {
          "type": "null"
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_root",
        "before_probe",
        "after_probe",
        "restoration_report",
        "arm64_before_receipt",
        "arm64_after_receipt"
      ],
