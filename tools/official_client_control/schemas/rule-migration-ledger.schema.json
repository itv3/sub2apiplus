{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2api.local/schemas/official-client-rule-migration-ledger-v1.json",
  "title": "VC-2 规则迁移台账",
  "description": "在不改写 VC-1 EvidencePackage 的前提下，冻结基线到目标版本的逐规则迁移结论。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "persona",
    "baseline_version",
    "target_version",
    "evidence_package_ref",
    "baseline_spec_ids",
    "target_spec_ids",
    "rules",
    "affected_rules",
    "inherited_rules",
    "identity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "official-client-rule-migration-ledger/v1"},
    "campaign_id": {"$ref": "#/$defs/safeId"},
    "persona": {"$ref": "#/$defs/persona"},
    "baseline_version": {"type": "string", "minLength": 1},
    "target_version": {"type": "string", "minLength": 1},
    "evidence_package_ref": {"$ref": "#/$defs/objectRef"},
    "baseline_spec_ids": {"$ref": "#/$defs/specIds"},
    "target_spec_ids": {"$ref": "#/$defs/nonEmptySpecIds"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    },
    "affected_rules": {"$ref": "#/$defs/specIds"},
    "inherited_rules": {"$ref": "#/$defs/specIds"},
    "identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "specId": {
      "type": "string",
      "pattern": "^SPEC-[A-Z0-9][A-Z0-9._-]{0,95}$"
    },
    "specIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/specId"}
    },
    "nonEmptySpecIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/specId"}
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "official_product", "auth_family", "upstream_route_family"],
      "properties": {
        "provider": {"$ref": "#/$defs/safeId"},
        "official_product": {"$ref": "#/$defs/safeId"},
        "auth_family": {"const": "oauth"},
        "upstream_route_family": {"$ref": "#/$defs/safeId"}
      }
    },
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_kind", "sha256"],
      "properties": {
        "object_kind": {"const": "evidence_package"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_id",
        "migration_decision",
        "evidence_level",
        "rule_lifecycle",
        "compatibility_class",
        "evidence_item_ids",
        "applicability"
      ],
      "properties": {
        "spec_id": {"$ref": "#/$defs/specId"},
        "migration_decision": {
          "enum": ["inherit", "change", "condition_change", "add", "delete"]
        },
        "evidence_level": {
          "enum": ["verified", "observed", "blocked", "regressed_evidence"]
        },
        "rule_lifecycle": {"enum": ["candidate", "active", "superseded"]},
        "compatibility_class": {
          "enum": ["request_egress", "response_compat", "not_applicable"]
        },
        "evidence_item_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safeId"}
        },
        "applicability": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
