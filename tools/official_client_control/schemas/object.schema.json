{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2api.local/schemas/official-client-control-object-v1.json",
  "title": "FW-D 内容寻址对象",
  "description": "对象只保存不可变制品；active、rollback 和 candidate 等部署角色由独立事实承载。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "object_kind", "payload"],
  "properties": {
    "schema_version": {"const": "official-client-control-object/v1"},
    "object_kind": {
      "enum": [
        "bootstrap",
        "persona_descriptor",
        "evidence_package",
        "rule_migration_ledger",
        "atomic_assertion_ledger",
        "validation_execution_plan",
        "candidate_evidence_package",
        "candidate_delivery_plan",
        "candidate_delivery_package",
        "private_archive_manifest",
        "model_capability_catalog",
        "profile_schema",
        "snapshot",
        "release_bundle",
        "release_artifact",
        "ingress_observation",
        "egress_observation",
        "production_ingress_inventory",
        "egress_disposition_inventory",
        "support_envelope",
        "active_support_envelope",
        "rollback_operational_envelope",
        "deployment_traffic_envelope",
        "persona_derivation",
        "compatibility_boundary",
        "scenario_plan",
        "deployment_plan",
        "runtime_catalog_snapshot",
        "operational_evidence",
        "promotion_diff",
        "acceptance_package",
        "tool_evolution_registration",
        "predecessor_import",
        "candidate_invalidation",
        "candidate_delivery_stage_invalidation",
        "candidate_delivery_recovery"
      ]
    },
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"object_kind": {"const": "tool_evolution_registration"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/toolEvolutionRegistration"}}}
    },
    {
      "if": {"properties": {"object_kind": {"const": "predecessor_import"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/predecessorImport"}}}
    },
    {
      "if": {"properties": {"object_kind": {"const": "candidate_invalidation"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/candidateInvalidation"}}}
    },
    {
      "if": {"properties": {"object_kind": {"const": "candidate_delivery_stage_invalidation"}}},
      "then": {"properties": {"payload": {"$ref": "candidate-delivery.schema.json#/$defs/stageInvalidation"}}}
    },
    {
      "if": {"properties": {"object_kind": {"const": "candidate_delivery_recovery"}}},
      "then": {"properties": {"payload": {"$ref": "candidate-delivery.schema.json#/$defs/recovery"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"},
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_kind", "sha256"],
      "properties": {
        "object_kind": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "factRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_id", "dimension", "sequence", "sha256"],
      "properties": {
        "campaign_id": {"$ref": "#/$defs/safeId"},
        "dimension": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "identityConditions": {
      "description": "前序导入核验的七项身份（B1-14）：每项为由 Campaign 冻结字段导出的值，不可证时为 null。official_artifacts 是官方产物绑定清单的规范摘要；platform／entrypoint 取 platforms／entrypoints 的唯一一项；privacy_mode 取 default_conditions 里唯一一条 privacy=<值>；oauth_org_id、model_catalog_sha256 只有 Campaign v2 才有。",
      "type": "object",
      "additionalProperties": false,
      "required": ["target_version", "official_artifacts", "platform", "entrypoint", "privacy_mode", "oauth_org_id", "model_catalog_sha256"],
      "properties": {
        "target_version": {"type": ["string", "null"]},
        "official_artifacts": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "platform": {"type": ["string", "null"]},
        "entrypoint": {"type": ["string", "null"]},
        "privacy_mode": {"type": ["string", "null"]},
        "oauth_org_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/safeId"}]},
        "model_catalog_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
      }
    },
    "predecessorImport": {
      "description": "Campaign v2 从前序 Store 导入证据的登记（B1-14）。predecessor.store_root 是登记时前序 Store 的绝对路径，只作出处，重放不解引用，且不得指向本 Store；imported_objects 按内容严格排序、必须对对象引用闭合，登记时已逐字节复制进本 Store，绑定 Campaign 控制状态或引用事实／收据的对象不可导入，自带 campaign_id 的对象必须属于前序 Campaign；imported_fact_refs 只能指向前序 Campaign 的事实，只作出处记录。两组七项身份只是申请方声明，导入收据从双方 Campaign 冻结字段独立导出后逐项核对。登记本身不授予任何引用权限。",
      "type": "object",
      "additionalProperties": false,
      "required": ["client", "campaign_id", "predecessor", "imported_objects", "imported_fact_refs", "identity_conditions", "source_identity_conditions", "mode", "approved_by", "approved_at_utc"],
      "properties": {
        "client": {"enum": ["codex", "claude"]},
        "campaign_id": {"$ref": "#/$defs/safeId"},
        "predecessor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["store_root", "campaign_id", "campaign_identity_sha256"],
          "properties": {
            "store_root": {"type": "string", "pattern": "^/"},
            "campaign_id": {"$ref": "#/$defs/safeId"},
            "campaign_identity_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "imported_objects": {"type": "array", "items": {"$ref": "#/$defs/objectRef"}},
        "imported_fact_refs": {"type": "array", "items": {"$ref": "#/$defs/factRef"}},
        "identity_conditions": {"$ref": "#/$defs/identityConditions"},
        "source_identity_conditions": {"$ref": "#/$defs/identityConditions"},
        "mode": {"enum": ["read_only_reuse", "regression_fixture"]},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at_utc": {"type": "string", "format": "date-time"}
      }
    },
    "candidateInvalidation": {
      "description": "Campaign v2 的候选作废（B3-05）：revision 是被作废候选所属的候选 revision，revision_ref 引用它的 candidate_revision_recorded 事实（只有没有显式 r1 事实的隐含 r1 可以为 null）。review_sha256 等于批准字段（approved_by、approved_at_utc、review_sha256）以外全部字段的规范摘要：preview 输出、apply 以 --approve-sha256 核对后一次写出。封存后当前 revision 进入 revision_required：候选级事实与收据一律拒绝，直到新 revision 事实以 invalidation_ref 引用本对象；同一 revision 只作废一次；已完成 VC-5 验收（validation_completed）的候选不得作废。",
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_id", "candidate_id", "revision", "revision_ref", "reason", "evidence_refs", "approved_by", "approved_at_utc", "review_sha256"],
      "properties": {
        "campaign_id": {"$ref": "#/$defs/safeId"},
        "candidate_id": {"$ref": "#/$defs/safeId"},
        "revision": {"type": "integer", "minimum": 1},
        "revision_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/factRef"}]},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/objectRef"}},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at_utc": {"type": "string", "format": "date-time"},
        "review_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "toolEvolutionRegistration": {
      "description": "Campaign v2 的工具演进登记：按 index 从 1 起成单链，previous_ref 在 index 1 时为 null；from_identity 承接上一份有效身份，to_identity 是登记时当前受管代码的身份。",
      "type": "object",
      "additionalProperties": false,
      "required": ["client", "campaign_id", "index", "from_identity", "to_identity", "evolution_receipt", "approved_by", "approved_at_utc", "previous_ref"],
      "properties": {
        "client": {"enum": ["codex", "claude"]},
        "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"},
        "index": {"type": "integer", "minimum": 1},
        "from_identity": {"$ref": "campaign-v2.schema.json#/$defs/toolIdentity"},
        "to_identity": {"$ref": "campaign-v2.schema.json#/$defs/toolIdentity"},
        "evolution_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at_utc": {"type": "string", "format": "date-time"},
        "previous_ref": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["object_kind", "sha256"],
              "properties": {
                "object_kind": {"const": "tool_evolution_registration"},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          ]
        }
      }
    }
  }
}
