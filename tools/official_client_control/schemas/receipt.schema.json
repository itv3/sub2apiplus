        "active_support_envelope_ref": {"type": "object"},
        "rollback_operational_envelope_ref": {"type": "object"},
        "deployment_traffic_envelope_ref": {"type": "object"},
        "final_ingress_inventory_ref": {"type": "object"},
        "final_egress_inventory_ref": {"type": "object"},
        "formal_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "final_state": {"const": "restored_active"},
        "input_facts_sha256": {"$ref": "#/$defs/sha256"},
        "completed_at_utc": {"type": "string", "format": "date-time"},
        "producer_tool_sha256": {"$ref": "#/$defs/sha256"},
        "formed_under": {"$ref": "#/$defs/formedUnder"}
      }
    },
    "candidateBuildV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "campaign_id", "candidate_id", "candidate_purpose", "target_version", "profile_approval_ref", "release_artifact_ref", "support_envelope_ref", "source_identity", "profile_identity", "validation_scope_sha256", "build_identity", "artifact_inventory", "image", "input_facts_sha256", "completed_at_utc", "producer_tool_sha256", "identity_sha256", "formed_under"],
      "properties": {
