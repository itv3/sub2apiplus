        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "formed_under": {"$ref": "#/$defs/formedUnder"}
      }
    },
    "candidateDeliveryV3": {
      "description": "候选交付收据 v3（B4-07，Campaign v2 在 B4-07 之后一律签发）：delivery_fact_refs 是唯一有效链四阶段的最终 pass；delivery_failure_refs 是该 delivery 的全部失败事实（按事实序号），stage_invalidation_refs 是被恢复段消费的阶段失效对象，recovery_refs 是恢复段预约（均按 dr 编号），三者都进入 input_facts_sha256。finalize 成功后该 delivery 为终态：同一交付包重复 finalize 重放核对后返回原收据，换交付包、追加事实、预约恢复段或申请阶段失效一律拒绝。",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "campaign_id", "campaign_purpose", "target_version", "profile_approval_ref", "candidate_id", "candidate_ref", "candidate_build_receipt_ref", "validation_completed_ref", "acceptance_ref", "candidate_evidence_package_ref", "delivery_plan_ref", "delivery_fact_refs", "candidate_delivery_package_ref", "private_archive_manifest_ref", "candidate_image_digest", "host_id", "architecture", "release_state", "vircs_state", "delivery_failure_refs", "stage_invalidation_refs", "recovery_refs", "input_facts_sha256", "completed_at_utc", "producer_tool_sha256", "identity_sha256", "formed_under"],
      "properties": {
        "schema_version": {"const": "official-client-candidate-delivery-receipt/v3"},
        "campaign_id": {"type": "string"},
        "campaign_purpose": {"enum": ["validation_only", "production_replacement"]},
        "target_version": {"type": "string"},
        "profile_approval_ref": {"type": "object"},
        "candidate_id": {"type": "string"},
        "candidate_ref": {"type": "object"},
        "candidate_build_receipt_ref": {"type": "object"},
        "validation_completed_ref": {"type": "object"},
        "acceptance_ref": {"type": "object"},
        "candidate_evidence_package_ref": {"type": "object"},
        "delivery_plan_ref": {"type": "object"},
        "delivery_fact_refs": {"type": "array", "minItems": 4, "maxItems": 4},
        "candidate_delivery_package_ref": {"type": "object"},
        "private_archive_manifest_ref": {"type": "object"},
        "candidate_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "host_id": {"type": "string"},
        "architecture": {"type": "string"},
        "release_state": {"const": "ready_for_operator_release"},
        "vircs_state": {"type": "object"},
        "delivery_failure_refs": {"type": "array", "items": {"type": "object"}},
        "stage_invalidation_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["object_kind", "sha256"], "properties": {"object_kind": {"const": "candidate_delivery_stage_invalidation"}, "sha256": {"$ref": "#/$defs/sha256"}}}},
        "recovery_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["object_kind", "sha256"], "properties": {"object_kind": {"const": "candidate_delivery_recovery"}, "sha256": {"$ref": "#/$defs/sha256"}}}},
        "input_facts_sha256": {"$ref": "#/$defs/sha256"},
        "completed_at_utc": {"type": "string", "format": "date-time"},
        "producer_tool_sha256": {"$ref": "#/$defs/sha256"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "formed_under": {"$ref": "#/$defs/formedUnder"}
      }
    },
    "predecessorImport": {
      "description": "前序证据导入收据（B1-14，只属于 Campaign v2）：source_campaign_document 是源 Campaign 身份文档（合同名、ID 与 identity_sha256 覆盖的全部冻结字段）的规范 JSON 文本，复算摘要必须等于 predecessor.campaign_identity_sha256；source_conditions／target_conditions 是从双方冻结字段独立导出的七项（等于两组声明），condition_source_fields 记录每项的来源字段，identity_differences 逐项列出不同或不可证的项；imported_facts 记录已在前序 Campaign 链上核验的事实坐标与种类。重放不打开前序 Store。只有 mode=read_only_reuse（此时 identity_differences 必为空）授予正式引用权限；一份登记只有一份收据。",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "campaign_id", "client", "import_ref", "mode", "predecessor", "source_campaign_document", "target_campaign_identity_sha256", "source_conditions", "target_conditions", "condition_source_fields", "identity_differences", "imported_objects", "imported_facts", "approved_by", "completed_at_utc", "producer_tool_sha256", "formed_under", "identity_sha256"],
      "properties": {
        "schema_version": {"const": "official-client-predecessor-import-receipt/v1"},
        "campaign_id": {"type": "string"},
        "client": {"enum": ["codex", "claude"]},
        "import_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["object_kind", "sha256"],
          "properties": {
            "object_kind": {"const": "predecessor_import"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "mode": {"enum": ["read_only_reuse", "regression_fixture"]},
        "predecessor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["store_root", "campaign_id", "campaign_identity_sha256"],
          "properties": {
            "store_root": {"type": "string", "pattern": "^/"},
            "campaign_id": {"type": "string"},
            "campaign_identity_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "source_campaign_document": {"type": "string", "minLength": 2},
        "target_campaign_identity_sha256": {"$ref": "#/$defs/sha256"},
        "source_conditions": {"$ref": "object.schema.json#/$defs/identityConditions"},
        "target_conditions": {"$ref": "object.schema.json#/$defs/identityConditions"},
        "condition_source_fields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_version", "official_artifacts", "platform", "entrypoint", "privacy_mode", "oauth_org_id", "model_catalog_sha256"],
          "properties": {
            "target_version": {"const": "target_version"},
            "official_artifacts": {"const": "official_artifacts"},
            "platform": {"const": "platforms"},
            "entrypoint": {"const": "entrypoints"},
            "privacy_mode": {"const": "default_conditions"},
            "oauth_org_id": {"const": "oauth_org_id"},
            "model_catalog_sha256": {"const": "model_catalog_sha256"}
          }
        },
        "identity_differences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item", "source", "target", "reason"],
            "properties": {
              "item": {"enum": ["target_version", "official_artifacts", "platform", "entrypoint", "privacy_mode", "oauth_org_id", "model_catalog_sha256"]},
              "source": {"type": ["string", "null"]},
              "target": {"type": ["string", "null"]},
              "reason": {"enum": ["different", "unprovable_in_source", "unprovable_in_target", "unprovable_in_both"]}
            }
          }
        },
        "imported_objects": {"type": "array", "items": {"$ref": "object.schema.json#/$defs/objectRef"}},
        "imported_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["campaign_id", "dimension", "sequence", "sha256", "fact_kind"],
            "properties": {
              "campaign_id": {"type": "string"},
              "dimension": {"type": "string"},
              "sequence": {"type": "integer", "minimum": 1},
              "sha256": {"$ref": "#/$defs/sha256"},
              "fact_kind": {"type": "string"}
            }
          }
        },
        "approved_by": {"type": "string", "minLength": 1},
        "completed_at_utc": {"type": "string", "format": "date-time"},
        "producer_tool_sha256": {"$ref": "#/$defs/sha256"},
        "formed_under": {"$ref": "#/$defs/formedUnder"},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
