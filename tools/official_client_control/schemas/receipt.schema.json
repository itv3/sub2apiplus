        "target_version": {"type": "string"},
        "profile_approval_ref": {"type": "object"},
        "candidate_id": {"type": "string"},
        "candidate_ref": {"type": "object"},
        "candidate_build_receipt_ref": {"type": "object"},
        "validation_completed_ref": {"type": "object"},
        "acceptance_ref": {"type": "object"},
        "candidate_evidence_package_ref": {"type": "object"},
        "delivery_plan_ref": {"type": "object"},
        "delivery_fact_refs": {"type": "array", "minItems": 4, "maxItems": 4},
        "candidate_delivery_package_ref": {"type": "object"},
        "private_archive_manifest_ref": {"type": "object"},
        "candidate_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "host_id": {"type": "string"},
        "architecture": {"type": "string"},
        "release_state": {"const": "ready_for_operator_release"},
        "vircs_state": {"type": "object"},
        "input_facts_sha256": {"$ref": "#/$defs/sha256"},
        "completed_at_utc": {"type": "string", "format": "date-time"},
        "producer_tool_sha256": {"$ref": "#/$defs/sha256"},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "formedUnder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_identity_ref", "candidate_revision", "evaluation_baseline"],
      "properties": {
        "tool_identity_ref": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["object_kind", "sha256"], "properties": {"object_kind": {"const": "tool_evolution_registration"}, "sha256": {"$ref": "#/$defs/sha256"}}}]},
        "candidate_revision": {"type": "integer", "minimum": 1},
        "evaluation_baseline": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["baseline", "baseline_commit_sha256"], "properties": {"baseline": {"type": "integer", "minimum": 1}, "baseline_commit_sha256": {"$ref": "#/$defs/sha256"}}}]}
      }
    },
    "promotionV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "campaign_id", "candidate_ref", "acceptance_ref", "promotion_fact_ref", "release_artifact_ref", "promotion_diff_ref", "profile_approval_ref", "input_facts_sha256", "completed_at_utc", "producer_tool_sha256", "formed_under"],
      "properties": {
