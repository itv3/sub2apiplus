        "candidate_purpose": {"enum": ["validation_only", "production_replacement"]},
        "target_version": {"type": "string"},
        "profile_approval_ref": {"type": "object"},
        "release_artifact_ref": {"type": "object"},
        "support_envelope_ref": {"type": "object"},
        "source_identity": {"type": "object"},
        "profile_identity": {"type": "object"},
        "validation_scope_sha256": {"$ref": "#/$defs/sha256"},
        "build_identity": {"type": "object"},
        "artifact_inventory": {"type": "object"},
        "image": {"type": "object"},
