{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2api.local/schemas/official-client-validation-candidate-v2.json",
  "title": "独立 ValidationCandidate",
  "description": "历史 v1 payload 可只读重放；新 Candidate 必须显式绑定 CandidateBuildReceipt。",
  "oneOf": [
    {"$ref": "#/$defs/legacy"},
    {"$ref": "#/$defs/strict"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "imageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_kind", "sha256"],
      "properties": {"object_kind": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "factRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_id", "dimension", "sequence", "sha256"],
      "properties": {
        "campaign_id": {"type": "string"},
        "dimension": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "receiptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_kind", "sha256"],
      "properties": {"receipt_kind": {"const": "candidate_build"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "profile_approval_ref", "release_artifact_ref", "support_envelope_ref", "source_tree_sha256", "test_tree_sha256", "dependency_lock_sha256", "target_architecture", "build_id", "image_digest", "candidate_purpose", "identity_sha256"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "profile_approval_ref": {"$ref": "#/$defs/factRef"},
        "release_artifact_ref": {"$ref": "#/$defs/objectRef"},
        "support_envelope_ref": {"$ref": "#/$defs/objectRef"},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "test_tree_sha256": {"$ref": "#/$defs/sha256"},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
        "target_architecture": {"type": "string", "minLength": 1},
        "build_id": {"type": "string", "minLength": 1},
        "image_digest": {"$ref": "#/$defs/imageDigest"},
        "candidate_purpose": {"enum": ["validation_only", "production_replacement"]},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "strict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "candidate_id", "profile_approval_ref", "release_artifact_ref", "support_envelope_ref", "source_tree_sha256", "test_tree_sha256", "dependency_lock_sha256", "target_architecture", "build_id", "image_digest", "candidate_purpose", "candidate_build_receipt_ref", "identity_sha256"],
      "properties": {
        "schema_version": {"const": "official-client-validation-candidate/v2"},
        "candidate_id": {"type": "string", "minLength": 1},
        "profile_approval_ref": {"$ref": "#/$defs/factRef"},
        "release_artifact_ref": {"$ref": "#/$defs/objectRef"},
        "support_envelope_ref": {"$ref": "#/$defs/objectRef"},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "test_tree_sha256": {"$ref": "#/$defs/sha256"},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
        "target_architecture": {"type": "string", "minLength": 1},
        "build_id": {"type": "string", "minLength": 1},
        "image_digest": {"$ref": "#/$defs/imageDigest"},
        "candidate_purpose": {"enum": ["validation_only", "production_replacement"]},
        "candidate_build_receipt_ref": {"$ref": "#/$defs/receiptRef"},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
