{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2api.local/schemas/official-client-control-campaign-v1.json",
  "title": "不可变官方客户端 Campaign",
  "description": "Campaign 身份随目标版本、官方产物、平台、入口、默认条件或工具身份变化。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "persona",
    "target_version",
    "official_artifacts",
    "platforms",
    "entrypoints",
    "default_conditions",
    "tool_bundle_sha256",
    "bootstrap_ref",
    "created_at_utc",
    "identity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "official-client-control-campaign/v1"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "persona": {"$ref": "#/$defs/persona"},
    "target_version": {"type": "string", "minLength": 1},
    "official_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "bootstrap.schema.json#/$defs/binding"}},
    "platforms": {"$ref": "#/$defs/nonEmptyStrings"},
    "entrypoints": {"$ref": "#/$defs/nonEmptyStrings"},
    "default_conditions": {"$ref": "#/$defs/nonEmptyStrings"},
    "tool_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "bootstrap_ref": {"$ref": "#/$defs/objectRef"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "official_product", "auth_family", "upstream_route_family"],
      "properties": {
        "provider": {"$ref": "#/$defs/id"},
        "official_product": {"$ref": "#/$defs/id"},
        "auth_family": {"const": "oauth"},
        "upstream_route_family": {"$ref": "#/$defs/id"}
      }
    },
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_kind", "sha256"],
      "properties": {
        "object_kind": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
