{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2api.local/schemas/official-client-control-bootstrap-v1.json",
  "title": "FW-D 根信任清单",
  "description": "绑定 FW-C 生产收据、FW-B 暂定合同、Codex Runtime Catalog 与控制工具身份。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_commit",
    "contract_sources",
    "contract_bundle_sha256",
    "fw_c_receipts",
    "runtime_catalog",
    "tool_bundle_sha256",
    "result"
  ],
  "properties": {
    "schema_version": {"const": "official-client-control-bootstrap/v1"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "contract_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
    "contract_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "fw_c_receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
    "runtime_catalog": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
    "tool_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "result": {"const": "stable"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
