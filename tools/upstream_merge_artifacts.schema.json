{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/official-egress-upstream-merge-artifacts-v1.json",
  "title": "Sub2API 上游合并阶段制品",
  "oneOf": [
    {"$ref": "#/$defs/baselineAcceptance"},
    {"$ref": "#/$defs/mergeStart"},
    {"$ref": "#/$defs/mergeCandidate"},
    {"$ref": "#/$defs/conflictLedger"},
    {"$ref": "#/$defs/sourceCandidate"},
    {"$ref": "#/$defs/surfaceDelta"},
    {"$ref": "#/$defs/surfaceReceipt"},
    {"$ref": "#/$defs/impactMatrix"},
    {"$ref": "#/$defs/changeDecisionReceipt"},
    {"$ref": "#/$defs/changeDecisionInput"},
    {"$ref": "#/$defs/verificationReceipt"},
    {"$ref": "#/$defs/clientGateReceipt"},
    {"$ref": "#/$defs/preflight"},
    {"$ref": "#/$defs/sourceTransition"},
    {"$ref": "#/$defs/candidateDisposition"},
    {"$ref": "#/$defs/branchApply"},
    {"$ref": "#/$defs/upstreamReceipt"},
    {"$ref": "#/$defs/freezeSuccessor"}
  ],
  "$defs": {
    "freezeSuccessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "issued_at_utc",
        "base_commit",
        "current_commit",
        "scope",
        "mode",
        "extra_worktree_paths",
        "frozen_path_count",
        "frozen_edge_count",
        "changed_path_count",
        "transitions",
        "unregistered_path_count",
        "unregistered_paths",
        "deleted_frozen_paths",
        "required_manual_actions",
        "verification",
        "safety",
        "result",
        "identity_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "official-egress-upstream-freeze-successor/v1"
        },
        "issued_at_utc": {
          "type": "string"
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "current_commit": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "type": "string",
          "pattern": "^upstream-[A-Za-z0-9][A-Za-z0-9._-]{0,191}-freeze-successor$"
        },
        "mode": {
          "enum": [
            "commit",
            "worktree"
          ]
        },
        "extra_worktree_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frozen_path_count": {
          "type": "integer",
          "minimum": 0
        },
        "frozen_edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "changed_path_count": {
          "type": "integer",
          "minimum": 0
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "old_path",
              "status",
              "predecessor_sha256s",
              "to_sha256",
              "source_receipts",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "old_path": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "A",
                  "M",
                  "T",
                  "R",
                  "C"
                ]
              },
              "predecessor_sha256s": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "to_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_receipts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "unregistered_path_count": {
          "type": "integer",
          "minimum": 0
        },
        "unregistered_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deleted_frozen_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_manual_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "path",
              "action_kind",
              "instruction",
              "verification"
            ],
            "properties": {
              "rule_id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "action_kind": {
                "enum": [
                  "python_receipt_list",
                  "script_constant",
                  "single_hop_file",
                  "manual_required"
                ]
              },
              "file": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "instruction": {
                "type": "string"
              },
              "verification": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "safety": {
          "type": "object"
        },
        "result": {
          "enum": [
            "passed_local_evidence_successor",
            "manual_actions_required"
          ]
        },
        "identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "baselineAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "issued_at_utc", "repository", "tool_bundle_sha256", "functional", "evidence", "result", "identity_sha256"],
      "properties": {
        "schema_version": {"const": "official-egress-upstream-baseline-acceptance/v1"},
        "issued_at_utc": {"type": "string", "minLength": 1},
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "tree"],
          "properties": {
            "commit": {"$ref": "#/$defs/gitObject"},
            "tree": {"$ref": "#/$defs/gitObject"}
          }
        },
        "tool_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "functional": {"$ref": "#/$defs/baselineGateSet"},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "checks", "known_drift"],
          "properties": {
            "result": {"enum": ["passed", "accepted_with_known_drift"]},
            "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/baselineCheck"}},
            "known_drift": {"type": "array", "items": {"$ref": "#/$defs/knownDrift"}}
          }
        },
        "result": {"const": "accepted"},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "baselineGateSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "checks"],
      "properties": {
        "result": {"const": "passed"},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/functionalBaselineCheck"}}
      }
    },
    "functionalBaselineCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "command", "observed_at_utc", "failure_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/safeId"},
        "status": {"const": "passed"},
        "command": {"type": "string", "minLength": 1},
        "observed_at_utc": {"type": "string", "minLength": 1},
        "failure_ids": {"type": "array", "maxItems": 0, "items": {"type": "string"}}
      }
    },
    "baselineCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "command", "observed_at_utc", "failure_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/safeId"},
        "status": {"enum": ["passed", "known_drift"]},
        "command": {"type": "string", "minLength": 1},
        "observed_at_utc": {"type": "string", "minLength": 1},
        "failure_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "knownDrift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "prior_sha256", "current_sha256", "source_receipts", "reason"],
      "properties": {
        "id": {"$ref": "#/$defs/safeId"},
        "path": {"type": "string", "minLength": 1},
        "prior_sha256": {"$ref": "#/$defs/sha256"},
        "current_sha256": {"$ref": "#/$defs/sha256"},
        "source_receipts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "executableIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "resolved_path", "sha256", "bytes"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "resolved_path": {"type": "string", "pattern": "^/"},
        "sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "bytes": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]}
      }
    },
    "gateCategory": {
      "enum": [
        "claude_active_wire",
        "claude_ingress_matrix",
        "claude_rollback_wire",
        "codex_active_wire",
        "codex_ingress_matrix",
        "codex_rollback_wire",
        "cross_persona",
        "inventory_closure",
        "original_business",
        "secret_scan",
        "shared_full_regression",
        "shared_static"
      ]
    },
    "revisionMetadata": {
      "allOf": [
        {
          "if": {"required": ["revision"]},
          "then": {"required": ["predecessor"]}
        },
        {
          "if": {"required": ["predecessor"]},
          "then": {"required": ["revision"]}
        }
      ]
    },
    "mergeStart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "plan_id", "plan_identity_sha256", "fork_head", "upstream_commit", "merge_base", "worktree", "merge_exit_code", "status", "conflict_paths", "conflict_stages", "stdout", "stderr", "identity_sha256"],
      "properties": {
        "schema_version": {"const": "official-egress-upstream-merge-start/v1"},
        "plan_id": {"type": "string"},
        "plan_identity_sha256": {"$ref": "#/$defs/sha256"},
        "fork_head": {"$ref": "#/$defs/gitObject"},
        "upstream_commit": {"$ref": "#/$defs/gitObject"},
        "merge_base": {"$ref": "#/$defs/gitObject"},
        "worktree": {"type": "string", "pattern": "^/"},
        "merge_exit_code": {"type": "integer"},
        "status": {"enum": ["conflicts_pending", "ready_to_seal"]},
        "conflict_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "conflict_stages": {"type": "array", "items": {"type": "object"}},
        "stdout": {"$ref": "#/$defs/binding"},
        "stderr": {"$ref": "#/$defs/binding"},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mergeCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "plan_id", "plan_identity_sha256", "merge_start", "conflict_ledger", "parents", "merge_commit", "candidate_tree", "changed_paths", "protected_objects_unchanged", "identity_sha256"],
      "properties": {
        "schema_version": {"const": "official-egress-upstream-merge-candidate-tree/v1"},
        "plan_id": {"type": "string"},
        "plan_identity_sha256": {"$ref": "#/$defs/sha256"},
        "merge_start": {"$ref": "#/$defs/binding"},
        "conflict_ledger": {"$ref": "#/$defs/binding"},
        "parents": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/gitObject"}},
        "merge_commit": {"$ref": "#/$defs/gitObject"},
        "candidate_tree": {"$ref": "#/$defs/gitObject"},
        "changed_paths": {"type": "array", "items": {"type": "object"}},
        "protected_objects_unchanged": {"const": true},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "conflictLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "plan_id", "plan_identity_sha256", "merge_start", "conflict_count", "conflict_paths", "resolution_input", "resolutions", "result", "identity_sha256"],
      "properties": {
        "schema_version": {"const": "official-egress-upstream-conflict-resolution-ledger/v1"},
        "plan_id": {"type": "string"},
        "plan_identity_sha256": {"$ref": "#/$defs/sha256"},
        "merge_start": {"$ref": "#/$defs/binding"},
        "conflict_count": {"type": "integer", "minimum": 0},
        "conflict_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "resolution_input": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]},
        "resolutions": {"type": "array", "items": {"type": "object"}},
        "result": {"const": "closed"},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceCandidate": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{"$ref": "#/$defs/revisionMetadata"}],
      "required": ["schema_version", "plan_id", "plan_identity_sha256", "merge_candidate", "source_commit", "source_tree", "changed_paths", "source_change_input", "codex_overlay_ledger", "identity_sha256"],
      "properties": {
        "schema_version": {"const": "official-egress-upstream-source-candidate/v1"},
        "plan_id": {"type": "string"},
        "plan_identity_sha256": {"$ref": "#/$defs/sha256"},
        "merge_candidate": {"$ref": "#/$defs/binding"},
        "source_commit": {"$ref": "#/$defs/gitObject"},
        "source_tree": {"$ref": "#/$defs/gitObject"},
        "changed_paths": {"type": "array", "items": {"type": "object"}},
        "source_change_input": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]},
        "codex_overlay_ledger": {"$ref": "#/$defs/binding"},
        "revision": {"type": "integer", "minimum": 1},
        "predecessor": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "surfaceDelta": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{"$ref": "#/$defs/revisionMetadata"}],
      "required": ["schema_version", "plan_id", "plan_identity_sha256", "source_candidate", "baseline_route_snapshot", "candidate_route_snapshot", "baseline_source_to_sink_snapshot", "candidate_source_to_sink_snapshot", "route_delta_count", "egress_delta_count", "deltas", "identity_sha256"],
      "properties": {
        "schema_version": {"const": "official-egress-upstream-surface-delta/v1"},
        "plan_id": {"type": "string"},
        "plan_identity_sha256": {"$ref": "#/$defs/sha256"},
        "source_candidate": {"$ref": "#/$defs/binding"},
        "baseline_route_snapshot": {"$ref": "#/$defs/binding"},
        "candidate_route_snapshot": {"$ref": "#/$defs/binding"},
        "baseline_source_to_sink_snapshot": {"$ref": "#/$defs/binding"},
        "candidate_source_to_sink_snapshot": {"$ref": "#/$defs/binding"},
        "route_delta_count": {"type": "integer", "minimum": 0},
        "egress_delta_count": {"type": "integer", "minimum": 0},
        "deltas": {"type": "array", "items": {"type": "object"}},
        "revision": {"type": "integer", "minimum": 1},
        "predecessor": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "surfaceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{"$ref": "#/$defs/revisionMetadata"}],
      "required": ["schema_version", "plan_id", "plan_identity_sha256", "source_candidate", "surface_delta", "route_snapshot", "source_to_sink_snapshot", "candidate_inventories", "surface_decision", "unknown_oauth_egress_count", "unclassified_delta_count", "result", "identity_sha256"],
      "properties": {
        "schema_version": {"const": "official-egress-upstream-surface-recalculation-receipt/v1"},
        "plan_id": {"type": "string"},
        "plan_identity_sha256": {"$ref": "#/$defs/sha256"},
        "source_candidate": {"$ref": "#/$defs/binding"},
        "surface_delta": {"$ref": "#/$defs/binding"},
        "route_snapshot": {"$ref": "#/$defs/binding"},
        "source_to_sink_snapshot": {"$ref": "#/$defs/binding"},
        "candidate_inventories": {"type": "object"},
        "surface_decision": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]},
        "unknown_oauth_egress_count": {"const": 0},
        "unclassified_delta_count": {"const": 0},
        "result": {"const": "closed"},
        "revision": {"type": "integer", "minimum": 1},
        "predecessor": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "impactMatrix": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{"$ref": "#/$defs/revisionMetadata"}],
      "required": ["schema_version", "plan_id", "plan_identity_sha256", "source_candidate", "surface_receipt", "file_change_count", "file_changes", "surface_delta_count", "surface_deltas", "classification_rule", "result", "identity_sha256"],
      "properties": {
        "schema_version": {"const": "official-egress-upstream-impact-matrix/v1"},
        "plan_id": {"type": "string"},
        "plan_identity_sha256": {"$ref": "#/$defs/sha256"},
        "source_candidate": {"$ref": "#/$defs/binding"},
        "surface_receipt": {"$ref": "#/$defs/binding"},
        "file_change_count": {"type": "integer", "minimum": 1},
        "file_changes": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "surface_delta_count": {"type": "integer", "minimum": 0},
        "surface_deltas": {"type": "array", "items": {"type": "object"}},
        "component_mapping": {"$ref": "#/$defs/componentMapping"},
        "classification_rule": {"type": "string"},
        "result": {"const": "pending_change_decision"},
        "revision": {"type": "integer", "minimum": 1},
        "predecessor": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "changeDecisionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{"$ref": "#/$defs/revisionMetadata"}],
      "required": ["schema_version", "plan_id", "plan_identity_sha256", "impact_matrix", "change_decision", "file_decision_count", "surface_decision_count", "client_impacts", "successor_campaign_required", "shared_contract_required", "unclassified_count", "official_client_identity_change_count", "result", "identity_sha256"],
      "properties": {
        "schema_version": {"const": "official-egress-upstream-change-decision-receipt/v1"},
        "plan_id": {"type": "string"},
        "plan_identity_sha256": {"$ref": "#/$defs/sha256"},
        "impact_matrix": {"$ref": "#/$defs/binding"},
        "change_decision": {"$ref": "#/$defs/binding"},
        "file_decision_count": {"type": "integer", "minimum": 1},
        "surface_decision_count": {"type": "integer", "minimum": 0},
        "client_impacts": {"type": "object"},
        "successor_campaign_required": {"type": "object"},
        "shared_contract_required": {"type": "boolean"},
        "unclassified_count": {"const": 0},
        "official_client_identity_change_count": {"const": 0},
        "component_mapping_schema": {"type": "string", "minLength": 1},
        "component_mapping_version": {"type": "string", "minLength": 1},
        "component_mapping_sha256": {"$ref": "#/$defs/sha256"},
        "auto_accepted_count": {"type": "integer", "minimum": 0},
        "manual_decision_count": {"type": "integer", "minimum": 0},
        "unknown_component_count": {"type": "integer", "minimum": 0},
        "result": {"const": "closed"},
        "revision": {"type": "integer", "minimum": 1},
        "predecessor": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "changeDecisionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "plan_id", "plan_identity_sha256", "source_tree", "impact_matrix_sha256", "files", "surface_deltas", "identity_sha256"],
      "properties": {
        "schema_version": {"const": "official-egress-upstream-change-decision-input/v1"},
        "plan_id": {"type": "string"},
        "plan_identity_sha256": {"$ref": "#/$defs/sha256"},
        "source_tree": {"$ref": "#/$defs/gitObject"},
        "impact_matrix_sha256": {"$ref": "#/$defs/sha256"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/changeDecisionFile"}},
        "surface_deltas": {"type": "array", "items": {"$ref": "#/$defs/changeDecisionSurface"}},
        "mapping_schema": {"type": "string", "minLength": 1},
        "mapping_version": {"type": "string", "minLength": 1},
        "mapping_sha256": {"$ref": "#/$defs/sha256"},
        "auto_accepted_count": {"type": "integer", "minimum": 0},
        "manual_required_count": {"type": "integer", "minimum": 0},
        "unresolved_paths": {"type": "array", "items": {"type": "string"}},
        "result": {"enum": ["ready_for_review", "ready_to_seal"]},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "changeDecisionFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "categories", "rationale", "required_actions", "official_client_identity_changed", "evidence_semantics_changed"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "categories": {"type": "array", "minItems": 1, "items": {"enum": ["claude_persona", "codex_persona", "key_group_routing_billing", "out_of_scope_product", "protocol_adapter", "repository_support", "shared_control"]}},
        "rationale": {"type": "string", "minLength": 1},
        "required_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "official_client_identity_changed": {"type": "boolean"},
        "evidence_semantics_changed": {"type": "boolean"},
        "decision_source": {"enum": ["manual", "auto", "manual_required"]},
        "component_ownership": {"type": "object"},
        "auto_reason": {"type": "string", "minLength": 1}
      }
    },
    "changeDecisionSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delta_id", "rationale", "required_actions"],
      "properties": {
        "delta_id": {"$ref": "#/$defs/sha256"},
        "rationale": {"type": "string", "minLength": 1},
        "required_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "decision_source": {"enum": ["manual", "auto", "manual_required"]}
      }
    },
    "verificationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "plan_id", "plan_identity_sha256", "attempt_id", "source_candidate", "impact_receipt", "required_categories", "gate_count", "failed_gate_ids", "skipped_gate_count", "worktree_status_paths", "gates", "result", "identity_sha256"],
      "properties": {
        "schema_version": {"const": "official-egress-upstream-verification-receipt/v1"},
        "plan_id": {"type": "string"},
        "plan_identity_sha256": {"$ref": "#/$defs/sha256"},
        "attempt_id": {"type": "string"},
        "baseline_acceptance": {"$ref": "#/$defs/binding", "description": "新计划的基线验收收据绑定"},
        "source_candidate": {"$ref": "#/$defs/binding"},
        "impact_receipt": {"$ref": "#/$defs/binding"},
        "required_categories": {"type": "array", "minItems": 12, "maxItems": 12},
        "gate_count": {"const": 12},
        "failed_gate_ids": {"type": "array"},
        "skipped_gate_count": {"const": 0},
        "worktree_status_paths": {"type": "array"},
        "gates": {"type": "array", "minItems": 12, "maxItems": 12},
        "client_receipts": {"$ref": "#/$defs/clientReceipts"},
        "executed_gate_count": {"type": "integer", "minimum": 0},
        "reused_gate_count": {"type": "integer", "minimum": 0},
        "execution_group_count": {"type": "integer", "minimum": 0},
        "from_attempt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]},
        "selected_gate_ids": {"type": "array", "items": {"type": "string"}},
        "not_executed_checks": {
          "type": "array",
          "items": {"type": "string"},
          "description": "门禁编排脚本状态文件里本机未执行、须由同一候选提交的 CI 证据补齐的检查"
        },
        "ci_evidence": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/ciEvidence"}],
          "description": "gates-import-ci 导入的 CI 证据；只能补齐 awaiting_ci 前序 attempt 的未执行项"
        },
        "result": {"enum": ["blocked", "awaiting_ci", "passed"]},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "ciEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "run_id", "run_attempt", "head_sha", "workflow_path", "event", "head_branch", "status", "conclusion", "jobs", "run_document", "jobs_document", "test_job_log", "covers"],
      "properties": {
        "provider": {"const": "github-actions"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"type": ["integer", "null"]},
        "head_sha": {"$ref": "#/$defs/gitObject"},
        "workflow_path": {"const": ".github/workflows/backend-ci.yml"},
        "event": {"type": ["string", "null"]},
        "head_branch": {"type": ["string", "null"]},
        "status": {"const": "completed"},
        "conclusion": {"const": "success"},
        "jobs": {"type": "array", "minItems": 1},
        "run_document": {"$ref": "#/$defs/binding"},
        "jobs_document": {"$ref": "#/$defs/binding"},
        "test_job_log": {"$ref": "#/$defs/binding"},
        "covers": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "componentMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "sha256"],
      "properties": {
        "schema": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
