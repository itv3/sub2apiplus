        "execution_group": {"type": "string", "minLength": 1},
        "execution_status": {"enum": ["executed", "group_reused", "attempt_reused"]},
        "result": {"enum": ["passed", "failed"]},
        "exit_code": {"type": "integer"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "executable": {"$ref": "#/$defs/executableIdentity"},
        "stdout": {"$ref": "#/$defs/binding"},
        "stderr": {"$ref": "#/$defs/binding"},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
